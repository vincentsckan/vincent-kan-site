---
export interface Props {
  title: string;
  description: string;
  url: string;
  compact?: boolean;
}

const { title, description, url, compact } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDesc = encodeURIComponent(description);
---

<div class="share-buttons">
  <span class="share-label">{compact ? '' : 'Share:'}</span>
  
  <!-- X/Twitter -->
  <a href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
     target="_blank" rel="noopener noreferrer" class="share-btn x-btn" 
     aria-label="Share on X">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
    {compact ? '' : ' X'}
  </a>

  <!-- WhatsApp -->
  <a href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
     target="_blank" rel="noopener noreferrer" class="share-btn wa-btn"
     aria-label="Share on WhatsApp">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    {compact ? '' : ' WhatsApp'}
  </a>

  <!-- Telegram -->
  <a href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`}
     target="_blank" rel="noopener noreferrer" class="share-btn tg-btn"
     aria-label="Share on Telegram">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
    </svg>
    {compact ? '' : ' Telegram'}
  </a>

  <!-- Facebook -->
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
     target="_blank" rel="noopener noreferrer" class="share-btn fb-btn"
     aria-label="Share on Facebook">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
    </svg>
    {compact ? '' : ' Facebook'}
  </a>

  <!-- Copy Link -->
  <button class="share-btn copy-btn" onclick="navigator.clipboard.writeText('${url}').then(()=>{this.classList.add('copied');setTimeout(()=>this.classList.remove('copied'),2000)})"
     aria-label="Copy link">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M7.24 2a2.5 2.5 0 00-2.47 2.09l-.01.03L3.07 16.5a2.5 2.5 0 002.47 2.91h7.12a2.5 2.5 0 002.47-2.09l.01-.03 1.7-12.38A2.5 2.5 0 0014.37 2H7.24zm0 1.5h7.13a1 1 0 01.98 1.2l-1.69 12.38a1 1 0 01-.99.84H5.54a1 1 0 01-.98-1.16L6.26 4.7a1 1 0 01.98-.8v.1zM9 8.25a.75.75 0 01.75.75v6a.75.75 0 01-1.5 0V9A.75.75 0 019 8.25zm4.5 0a.75.75 0 01.75.75v6a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75z"/>
    </svg>
    {compact ? '' : ' Copy'}
    <span class="copy-msg">Copied!</span>
  </button>
</div>

<style is:global>
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    background: var(--bg-card, #f8f9fa);
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #e2e8f0);
  }

  .share-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted, #64748b);
    margin-right: 0.25rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    color: #fff;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .share-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
    color: #fff;
  }

  .x-btn { background: #000; }
  .wa-btn { background: #25D366; }
  .tg-btn { background: #0088cc; }
  .fb-btn { background: #1877F2; }
  .copy-btn { background: #64748b; }

  .copy-btn .copy-msg {
    display: none;
    font-size: 0.75rem;
  }
  .copy-btn.copied .copy-msg {
    display: inline;
  }
  .copy-btn.copied svg {
    display: none;
  }
</style>
