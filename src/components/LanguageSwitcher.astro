// LanguageSwitcher.astro - Language toggle that keeps the same page
// Smart conversion: e.g. /vincent-kan-site/about -> /vincent-kan-site/zh/about

import { useTranslations, getLangFromUrl, languages, defaultLang } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Determine target language
const targetLang = lang === 'en' ? 'zh' : 'en';

// Build the localized path, preserving the current page
// Strip /vincent-kan-site prefix to get the page path
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/vincent-kan-site/, '') || '/';

// If current is zh, remove /zh prefix for the page part
const pagePath = lang === 'zh' 
  ? cleanPath.replace(/^\/zh/, '') || '/'
  : cleanPath;

// Build target URL
const targetHref = targetLang === 'en' 
  ? `/vincent-kan-site${pagePath}`
  : `/vincent-kan-site/${targetLang}${pagePath}`;
---

<div class="lang-switcher">
  <a href={targetHref} class="lang-link" title={t('lang.switch')}>
    <span class="lang-icon">🌐</span>
    <span class="lang-text">{t('lang.switch')}</span>
  </a>
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
  }
  .lang-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-family: 'SF Mono', 'SFMono-Regular', monospace;
    transition: all 0.2s;
    border: 1px solid transparent;
  }
  .lang-link:hover {
    color: var(--neon-cyan);
    border-color: rgba(0, 229, 255, 0.15);
    background: rgba(0, 229, 255, 0.03);
  }
  .lang-icon {
    font-size: 0.9rem;
  }
  .lang-text {
    white-space: nowrap;
  }
</style>
