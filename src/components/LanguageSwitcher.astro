---
// LanguageSwitcher.astro - Language toggle that keeps the same page
// Reliable path construction without relying on getLocalizedPath()

const lang = Astro.url.pathname.startsWith('/vincent-kan-site/zh') ? 'zh' : 'en';
const targetLang = lang === 'en' ? 'zh' : 'en';

// Get the current page path relative to the language root
// e.g. /vincent-kan-site/zh/about -> about
// e.g. /vincent-kan-site/about -> about
// e.g. /vincent-kan-site/zh/ -> (empty)
// e.g. /vincent-kan-site/ -> (empty)

// Strip the base
let pagePart = Astro.url.pathname.replace(/^\/vincent-kan-site/, '') || '/';
// If zh, strip the /zh or /zh/ prefix
if (lang === 'zh') {
  pagePart = pagePart.replace(/^\/zh/, '') || '/';
}
if (!pagePart.startsWith('/')) pagePart = '/' + pagePart;

// Build target href
let targetHref;
if (targetLang === 'en') {
  targetHref = `/vincent-kan-site${pagePart === '/' ? '' : pagePart}`;
} else {
  targetHref = `/vincent-kan-site/zh${pagePart === '/' ? '' : pagePart}`;
}

// Fallback: ensure we always have sensible defaults
if (!targetHref || targetHref === '/vincent-kan-site/zh//') {
  targetHref = targetLang === 'en' ? '/vincent-kan-site/' : '/vincent-kan-site/zh/';
}

import { useTranslations } from '../i18n';
const t = useTranslations(lang);
---

<div class="lang-switcher">
  <a href={targetHref} class="lang-link" title={t('lang.switch')}>
    <span class="lang-icon">🌐</span>
    <span class="lang-text">{t('lang.switch')}</span>
  </a>
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
  }
  .lang-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-family: 'SF Mono', 'SFMono-Regular', monospace;
    transition: all 0.2s;
    border: 1px solid transparent;
  }
  .lang-link:hover {
    color: var(--neon-cyan);
    border-color: rgba(0, 229, 255, 0.15);
    background: rgba(0, 229, 255, 0.03);
  }
  .lang-icon {
    font-size: 0.9rem;
  }
  .lang-text {
    white-space: nowrap;
  }
</style>
