---
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE_TITLE } from '../consts';
import { useTranslations, getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header>
  <nav>
    <a href={lang === 'en' ? '/' : '/zh/'} class="logo">
      <img src="/logo/ufo-logo.svg" alt="Disclosure HK" class="logo-img" />
    </a>
    <div class="nav-links">
      <HeaderLink href={lang === 'en' ? '/' : '/zh/'}>{t('nav.home')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/blog' : '/zh/blog'}>{t('nav.blog')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/projects' : '/zh/projects'}>{t('nav.projects')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/forum' : '/zh/forum'}>{t('nav.forum')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/about' : '/zh/about'}>{t('nav.about')}</HeaderLink>
      <LanguageSwitcher />
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10,10,18,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .logo-img {
    height: 30px;
    width: auto;
    display: block;
  }
  .logo-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .nav-links { display: flex; gap: 0.25rem; }
  .nav-links a {
    padding: 0.35rem 0.6rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
  }
  .nav-links a:hover { 
    background: rgba(0,229,255,0.06); 
    color: var(--neon-cyan);
    box-shadow: 0 0 12px rgba(0,229,255,0.06);
  }
  @media (max-width: 600px) {
    nav { padding: 0 1rem; }
    .nav-links a { padding: 0.4rem 0.5rem; font-size: 0.85rem; }
  }
</style>
