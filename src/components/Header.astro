---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a href="/site/" class="logo">{SITE_TITLE}</a>
    <div class="nav-links">
      <HeaderLink href="/site/">Home</HeaderLink>
      <HeaderLink href="/site/blog">Blog</HeaderLink>
      <HeaderLink href="/site/projects">Projects</HeaderLink>
      <HeaderLink href="/site/about">About</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .nav-links { display: flex; gap: 0.25rem; }
  .nav-links a {
    padding: 0.45rem 0.75rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s;
  }
  .nav-links a:hover { background: var(--bg-secondary); color: var(--text); }
  @media (max-width: 600px) {
    nav { padding: 0 1rem; }
    .nav-links a { padding: 0.4rem 0.5rem; font-size: 0.82rem; }
  }
</style>
