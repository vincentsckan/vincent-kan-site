---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <strong class="footer-name">> Vincent Kan</strong>
        <span class="footer-tagline">// 科技愛好者 · UFO/UAP 研究者 · AI 玩家</span>
      </div>
      <div class="footer-nav">
        <a href="/vincent-kan-site/">首頁</a>
        <a href="/vincent-kan-site/blog">文章</a>
        <a href="/vincent-kan-site/projects">專案</a>
        <a href="/vincent-kan-site/about">關於</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {today.getFullYear()} Vincent Kan</span>
      <span class="footer-built">由 Astro 構建</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 3rem 1.5rem 1.5rem;
    position: relative;
  }
  footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 10%;
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-purple), transparent);
    opacity: 0.5;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .footer-name {
    font-size: 1rem;
    color: var(--text);
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
  }
  .footer-tagline {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-top: 0.25rem;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .footer-nav { display: flex; gap: 1.2rem; }
  .footer-nav a {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: all 0.2s;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .footer-nav a:hover { color: var(--neon-cyan); text-shadow: 0 0 6px rgba(0,229,255,0.3); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    color: var(--text-muted);
    font-size: 0.78rem;
  }
  .footer-built {
    color: rgba(0,229,255,0.3);
  }
  @media (max-width: 600px) {
    .footer-top { flex-direction: column; gap: 1rem; }
    .footer-bottom { flex-direction: column; gap: 0.25rem; }
  }
</style>
