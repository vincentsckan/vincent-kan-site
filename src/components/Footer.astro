---
import { useTranslations, getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <strong class="footer-name">> Vincent Kan</strong>
        <span class="footer-tagline">{t('home.subtitle')}</span>
      </div>
      <div class="footer-nav">
        <a href={lang === 'en' ? '/vincent-kan-site/' : '/vincent-kan-site/zh/'}>{t('nav.home')}</a>
        <a href={lang === 'en' ? '/vincent-kan-site/blog' : '/vincent-kan-site/zh/blog'}>{t('nav.blog')}</a>
        <a href={lang === 'en' ? '/vincent-kan-site/projects' : '/vincent-kan-site/zh/projects'}>{t('nav.projects')}</a>
        <a href={lang === 'en' ? '/vincent-kan-site/about' : '/vincent-kan-site/zh/about'}>{t('nav.about')}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t('footer.copyright').replace('2026', today.getFullYear().toString())}</span>
      <div class="footer-right">
        <span class="footer-counter">
          <img src="https://visitor-badge.laobi.icu/badge?page_id=vincentkan.vincent-kan-site" alt="visitors" style="height:18px;vertical-align:middle;border-radius:3px;" />
        </span>
        <span class="footer-built">{t('footer.privacy')}</span>
      </div>
    </div>


  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 3rem 1.5rem 1.5rem;
    position: relative;
  }
  footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 10%;
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-purple), transparent);
    opacity: 0.5;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .footer-name {
    font-size: 1rem;
    color: var(--text);
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
  }
  .footer-tagline {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-top: 0.25rem;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .footer-nav { display: flex; gap: 1.2rem; }
  .footer-nav a {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: all 0.2s;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .footer-nav a:hover { color: var(--neon-cyan); text-shadow: 0 0 6px rgba(0,229,255,0.3); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .footer-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .footer-counter {
    display: inline-flex;
    align-items: center;
    opacity: 0.8;
  }
  .footer-counter img {
    height: 18px;
    border-radius: 3px;
  }
  .footer-built {
    color: rgba(0,229,255,0.3);
  }
  @media (max-width: 600px) {
    .footer-top { flex-direction: column; gap: 1rem; }
    .footer-bottom { flex-direction: column; gap: 0.25rem; }
  }
</style>
