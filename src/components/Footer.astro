---
import { useTranslations, getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <strong class="footer-name">> Davis Kan</strong>
        <span class="footer-tagline">{t('home.subtitle')}</span>
      </div>
      <div class="footer-nav">
        <a href={lang === 'en' ? '/' : '/zh/'}>{t('nav.home')}</a>
        <a href={lang === 'en' ? '/blog' : '/zh/blog'}>{t('nav.blog')}</a>
        <a href={lang === 'en' ? '/projects' : '/zh/projects'}>{t('nav.projects')}</a>
        <a href={lang === 'en' ? '/about' : '/zh/about'}>{t('nav.about')}</a>
      </div>
      <div class="footer-social">
        <a href="https://x.com/disclosurehk" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://t.me/disclosurehk" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Telegram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t('footer.copyright').replace('2026', today.getFullYear().toString())}</span>
      <div class="footer-right">
        <span class="footer-counter" id="visit-counter">👁️ <span class="count-num">--</span> {lang === 'en' ? 'visitors' : '瀏覽次數'}</span>
        <span class="footer-built">{t('footer.privacy')}</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
(function() {
  var el = document.getElementById('visit-counter');
  if (!el) return;
  var numEl = el.querySelector('.count-num');
  if (!numEl) return;
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/counter/visits.json', true);
  xhr.onload = function() {
    try {
      var data = JSON.parse(xhr.responseText);
      if (data && data.total !== undefined) {
        numEl.textContent = data.total.toLocaleString();
      }
    } catch(e) {}
  };
  xhr.send();
})();
</script>
    </div>


  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 3rem 1.5rem 1.5rem;
    position: relative;
  }
  footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 10%;
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-purple), transparent);
    opacity: 0.5;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .footer-name {
    font-size: 1rem;
    color: var(--text);
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
  }
  .footer-tagline {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-top: 0.25rem;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .footer-nav { display: flex; gap: 1.2rem; }
  .footer-nav a {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: all 0.2s;
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
  }
  .footer-nav a:hover { color: var(--neon-cyan); text-shadow: 0 0 6px rgba(0,229,255,0.3); }
  .footer-social { display: flex; gap: 0.8rem; align-items: center; }
  .social-link { color: var(--text-muted); transition: all 0.2s; display: flex; align-items: center; padding: 4px; border-radius: 4px; }
  .social-link:hover { color: var(--neon-cyan); text-shadow: 0 0 6px rgba(0,229,255,0.3); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .footer-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .footer-counter {
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: 'SF Mono', 'JetBrains Mono', monospace;
    opacity: 0.8;
  }
  .footer-counter .count-num {
    color: var(--neon-cyan);
    font-weight: 600;
    margin: 0 2px;
  }
  .footer-built {
    color: rgba(0,229,255,0.3);
  }
  @media (max-width: 600px) {
    .footer-top { flex-direction: column; gap: 1rem; }
    .footer-social { margin-left: 0; }
    .footer-bottom { flex-direction: column; gap: 0.25rem; }
  }
</style>
