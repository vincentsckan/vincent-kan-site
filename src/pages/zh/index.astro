---
// /zh/index.astro - Chinese version of Home
// Reuses the same logic as index.astro but forces Chinese language
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { ui, defaultLang } from '../../i18n';

const lang = 'zh';
const t = (key) => ui[lang][key] || ui.en[key] || key;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const uapPosts = posts.filter(p => p.id.startsWith('ufo-')).slice(0, 6);
const otherPosts = posts.filter(p => !p.id.startsWith('ufo-')).slice(0, 4);
const latestUAP = uapPosts[0];
---

<!DOCTYPE html>
<html lang="zh-HK">
  <head>
    <BaseHead title="Vincent Kan — UFO/UAP 研究與新聞" description="科技愛好者 • UFO/UAP 研究者 • AI 玩家 • 香港人" />
    <style is:inline>
@keyframes fadeIn { 0%{opacity:0} 100%{opacity:1} }
@keyframes slideUp { 0%{transform:translateY(15px);opacity:0} 100%{transform:translateY(0);opacity:1} }
@keyframes pulseDot { 0%,100%{opacity:1} 50%{opacity:0.3} }
    </style>
    <style>
      .home-wrap { max-width: 860px; margin: 0 auto; padding: 0 1.5rem; }
      
      .hero-section {
        text-align: center;
        padding: 4rem 0 3rem;
        animation: slideUp 0.5s ease both;
      }
      .hero-section h1 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }
      .hero-section h1 .acc {
        color: var(--neon-cyan);
        text-shadow: 0 0 20px rgba(0,229,255,0.3);
      }
      .hero-section p {
        color: var(--text-muted);
        font-size: 0.92rem;
        max-width: 560px;
        margin: 0 auto 1.5rem;
        line-height: 1.6;
      }
      .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        background: rgba(0,229,255,0.1);
        border: 1px solid rgba(0,229,255,0.2);
        color: var(--neon-cyan);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
        font-family: 'SF Mono', monospace;
      }
      .hero-cta:hover {
        background: rgba(0,229,255,0.15);
        box-shadow: 0 0 20px rgba(0,229,255,0.1);
      }

      .breaking {
        display: flex; gap: 0.75rem; align-items: center;
        padding: 0.7rem 1rem;
        border: 1px solid rgba(239,68,68,0.15);
        border-radius: var(--radius-sm);
        background: rgba(239,68,68,0.04);
        margin-bottom: 1.5rem; margin-top: 0.5rem;
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: slideUp 0.6s ease both;
      }
      .breaking:hover { border-color: rgba(239,68,68,0.3); }
      .breaking-dot { width: 8px; height: 8px; background: #ef4444; border-radius: 50%; flex-shrink: 0; animation: pulseDot 1.5s infinite; }
      .breaking-label { font-family:'SF Mono',monospace; font-size:0.68rem; color:#ef4444; font-weight:600; letter-spacing:0.05em; flex-shrink:0; }
      .breaking-title { font-size:0.85rem; font-weight:500; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .breaking-arrow { flex-shrink:0; font-size:0.75rem; color:var(--text-muted); }

      .featured {
        display: grid; grid-template-columns: 1.4fr 1fr; gap: 1rem;
        margin-bottom: 2.5rem;
        animation: slideUp 0.5s ease both;
        animation-delay: 0.1s;
      }
      .featured-main {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        text-decoration: none; color: inherit;
        transition: all 0.3s;
        display: flex; flex-direction: column;
      }
      .featured-main:hover { border-color: var(--neon-cyan); box-shadow: 0 0 20px rgba(0,229,255,0.04); }
      .featured-main-top { padding: 1.5rem 1.5rem 1rem; flex: 1; }
      .featured-tag {
        display: inline-block;
        font-family:'SF Mono',monospace; font-size:0.62rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        background: rgba(0,229,255,0.08);
        color: var(--neon-cyan);
        letter-spacing: 0.05em;
        margin-bottom: 0.6rem;
      }
      .featured-main h2 { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.4rem; line-height: 1.3; }
      .featured-main p { font-size: 0.82rem; color: var(--text-secondary); margin: 0 0 0.8rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .featured-main-footer { padding: 0.7rem 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-size: 0.72rem; font-family:'SF Mono',monospace; color: var(--text-muted); }
      .featured-side { display: flex; flex-direction: column; gap: 0.75rem; }
      .featured-side-item { display: flex; gap: 0.75rem; padding: 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s; flex: 1; }
      .featured-side-item:hover { border-color: var(--neon-cyan); }
      .featured-side-icon { font-size: 1rem; margin-top: 0.1rem; }
      .featured-side-body { flex: 1; min-width: 0; }
      .featured-side-body h3 { font-size: 0.82rem; font-weight: 600; margin-bottom: 0.1rem; }
      .featured-side-body p { font-size: 0.72rem; color: var(--text-muted); margin: 0; }
      .section-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; animation: slideUp 0.4s ease both; animation-delay: 0.2s; }
      .section-hd-left { display: flex; align-items: center; gap: 0.6rem; }
      .section-hd-acc { font-family:'SF Mono',monospace; font-size:0.65rem; color: var(--neon-cyan); letter-spacing:0.08em; padding: 0.15rem 0.4rem; border: 1px solid rgba(0,229,255,0.15); border-radius: 4px; }
      .section-hd h2 { font-size: 1.15rem; font-weight: 700; }
      .section-hd a { font-size: 0.78rem; color: var(--text-muted); font-family:'SF Mono',monospace; }
      .section-hd a:hover { color: var(--neon-cyan); }
      .uap-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-bottom: 2.5rem; }
      .uap-card { padding: 1rem 1.2rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.25s; animation: slideUp 0.4s ease both; }
      .uap-card:hover { border-color: var(--neon-cyan); transform: translateY(-1px); }
      .uap-card-meta { font-family:'SF Mono',monospace; font-size:0.62rem; color: var(--text-muted); margin-bottom: 0.25rem; display: flex; gap: 0.4rem; }
      .uap-card-meta .uap-tag { color: var(--neon-cyan); font-weight: 600; }
      .uap-card h3 { font-size: 0.88rem; font-weight: 600; margin-bottom: 0.2rem; }
      .uap-card p { font-size: 0.76rem; color: var(--text-secondary); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .domains { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem; margin-bottom: 2rem; }
      .domain-item { padding: 1rem 0.75rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm); text-align: center; text-decoration: none; color: inherit; transition: all 0.2s; }
      .domain-item:hover { border-color: var(--neon-cyan); }
      .domain-icon { font-size: 1.2rem; margin-bottom: 0.25rem; }
      .domain-label { font-size: 0.72rem; font-weight: 500; }
      .domain-count { font-size: 0.62rem; font-family:'SF Mono',monospace; color: var(--neon-cyan); margin-top: 0.15rem; }
      @media(max-width: 700px) {
        .hero-section h1 { font-size: 1.5rem; }
        .featured { grid-template-columns: 1fr; }
        .uap-grid { grid-template-columns: 1fr; }
        .domains { grid-template-columns: repeat(3, 1fr); }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="home-wrap">
        <section class="hero-section">
          <h1><span class="acc">UFO</span>/UAP 研究與新聞庫</h1>
          <p>UFO/UAP 案例庫、每日新聞更新、深度研究分析 — 免費開放</p>
          <a href="/vincent-kan-site/zh/blog" class="hero-cta">瀏覽文章 →</a>
        </section>

        {latestUAP && (
          <a href={`/vincent-kan-site/blog/${latestUAP.id}/`} class="breaking">
            <span class="breaking-dot"></span>
            <span class="breaking-label">突發</span>
            <span class="breaking-title">{latestUAP.data.title}</span>
            <span class="breaking-arrow">→</span>
          </a>
        )}

        <div class="featured">
          {latestUAP ? (
            <a href={`/vincent-kan-site/blog/${latestUAP.id}/`} class="featured-main">
              <div class="featured-main-top">
                <span class="featured-tag">🛸 UFO/UAP</span>
                <h2>{latestUAP.data.title}</h2>
                <p>{latestUAP.data.description}</p>
              </div>
              <div class="featured-main-footer">
                <span><FormattedDate date={latestUAP.data.pubDate} /></span>
                <span>閱讀全文 →</span>
              </div>
            </a>
          ) : (
            <div class="featured-main">
              <div class="featured-main-top">
                <span class="featured-tag">🛸 UFO/UAP</span>
                <h2>全球UFO/UAP新聞摘要</h2>
                <p>AI自動搜集每日全球UFO重點新聞，涵蓋政府披露、懸案分析。</p>
              </div>
            </div>
          )}
          <div class="featured-side">
            {uapPosts.slice(1, 3).map(p => (
              <a href={`/vincent-kan-site/blog/${p.id}/`} class="featured-side-item">
                <div class="featured-side-icon">🛸</div>
                <div class="featured-side-body">
                  <h3>{p.data.title}</h3>
                  <p><FormattedDate date={p.data.pubDate} /></p>
                </div>
              </a>
            ))}
            {otherPosts.slice(0, 1).map(p => (
              <a href={`/vincent-kan-site/blog/${p.id}/`} class="featured-side-item">
                <div class="featured-side-icon">📝</div>
                <div class="featured-side-body">
                  <h3>{p.data.title}</h3>
                  <p><FormattedDate date={p.data.pubDate} /></p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="domains">
          <a href="/vincent-kan-site/zh/blog" class="domain-item">
            <div class="domain-icon">🛸</div>
            <div class="domain-label">UFO 新聞</div>
            <div class="domain-count">{uapPosts.length} 篇</div>
          </a>
          <a href="/vincent-kan-site/zh/projects" class="domain-item">
            <div class="domain-icon">⚡</div>
            <div class="domain-label">專案</div>
            <div class="domain-count">3 個</div>
          </a>
          <a href="/vincent-kan-site/zh/about" class="domain-item">
            <div class="domain-icon">👤</div>
            <div class="domain-label">關於我</div>
            <div class="domain-count">簡介</div>
          </a>
          <a href="/vincent-kan-site/forum" class="domain-item">
            <div class="domain-icon">💬</div>
            <div class="domain-label">討論區</div>
            <div class="domain-count">交流學習</div>
          </a>
          <a href="/vincent-kan-site/zh/blog" class="domain-item">
            <div class="domain-icon">📰</div>
            <div class="domain-label">全部文章</div>
            <div class="domain-count">{posts.length} 篇</div>
          </a>
        </div>

        {uapPosts.length > 1 && (
          <>
            <div class="section-hd">
              <div class="section-hd-left">
                <span class="section-hd-acc">/UAP</span>
                <h2>UFO 新聞總覽</h2>
              </div>
              <a href="/vincent-kan-site/zh/blog">查看全部 →</a>
            </div>
            <div class="uap-grid">
              {uapPosts.slice(1, 5).map(p => (
                <a href={`/vincent-kan-site/blog/${p.id}/`} class="uap-card">
                  <div class="uap-card-meta">
                    <span class="uap-tag">🛸 UFO/UAP</span>
                    <span><FormattedDate date={p.data.pubDate} /></span>
                  </div>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
      
      <Footer />
    </main>
  </body>
</html>
