---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={`🛸 全球UFO目擊地圖 — ${SITE_TITLE}`} description="全球UFO/UAP目擊統計熱力地圖，查看各國UFO個案數量排名" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <style>
      .map-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
        font-family: var(--font-atkinson, sans-serif);
      }
      .map-page h1 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
      }
      .map-page .subtitle {
        color: #888;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
      }
      #ufoMap {
        width: 100%;
        height: 520px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #1e3a5f;
        z-index: 1;
      }
      /* Leaflet overrides for dark theme */
      .leaflet-container {
        background: #0a1628 !important;
        font-family: var(--font-atkinson, sans-serif) !important;
      }
      .leaflet-control-zoom a {
        background: #1a2f44 !important;
        color: #e0e8f0 !important;
        border-color: #1e3a5f !important;
      }
      .leaflet-control-zoom a:hover {
        background: #2a4a6a !important;
      }
      .leaflet-control-attribution {
        background: rgba(10,22,40,0.8) !important;
        color: #666 !important;
        font-size: 10px !important;
      }
      .leaflet-control-attribution a {
        color: #8ab4f8 !important;
      }
      /* Custom popup */
      .custom-popup .leaflet-popup-content-wrapper {
        background: rgba(13, 27, 42, 0.95);
        color: #e0e8f0;
        border: 1px solid #3a7bd5;
        border-radius: 8px;
        backdrop-filter: blur(8px);
      }
      .custom-popup .leaflet-popup-tip {
        background: #3a7bd5;
      }
      .custom-popup .leaflet-popup-content-wrapper {
        animation: popIn 0.25s ease-out;
      }
      @keyframes popIn {
        from { transform: scale(0.7); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }
      /* Glow pulse on circles */
      .glow-circle {
        animation: glowPulse 3s ease-in-out infinite;
      }
      @keyframes glowPulse {
        0%, 100% { filter: drop-shadow(0 0 4px currentColor); }
        50% { filter: drop-shadow(0 0 12px currentColor); }
      }
      .recent-ring {
        animation: ringExpand 2s ease-out infinite;
      }
      @keyframes ringExpand {
        0% { r: var(--base-r); opacity: 0.6; }
        100% { r: calc(var(--base-r) + 12); opacity: 0; }
      }
      .popup-content {
        min-width: 180px;
      }
      .popup-content .country-name {
        font-weight: bold;
        font-size: 1rem;
        margin-bottom: 4px;
        color: #fff;
      }
      .popup-content .stat {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin: 2px 0;
        font-size: 0.85rem;
      }
      .popup-content .stat-label { color: #8ab4f8; }
      .popup-content .stat-val { color: #fbbc04; font-weight: bold; }
      .popup-content .recent-badge {
        color: #4caf50;
        font-size: 0.75rem;
        margin-top: 4px;
      }
      .popup-content .read-more-link {
        display: inline-block;
        margin-top: 6px;
        color: #8ab4f8;
        font-size: 0.75rem;
        text-decoration: none;
      }
      .popup-content .read-more-link:hover {
        text-decoration: underline;
      }
      .legend {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 16px;
        font-size: 0.75rem;
        color: #aaa;
        flex-wrap: wrap;
        margin-top: 8px;
      }
      .legend-bar {
        display: flex;
        height: 12px;
        border-radius: 4px;
        overflow: hidden;
      }
      .legend-bar span { width: 22px; }
      .stats-section {
        background: #0d1b2a;
        border: 1px solid #1e3a5f;
        border-radius: 12px;
        padding: 1.2rem;
        margin-bottom: 2rem;
        margin-top: 1.2rem;
      }
      .stats-section h2 {
        font-size: 1.3rem;
        margin-bottom: 1rem;
        color: #fbbc04;
      }
      .stats-table-wrap {
        max-height: 480px;
        overflow-y: auto;
      }
      .stats-table-wrap::-webkit-scrollbar { width: 6px; }
      .stats-table-wrap::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 3px; }
      table.stats-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }
      table.stats-table th {
        text-align: left;
        padding: 8px 10px;
        border-bottom: 1px solid #1e3a5f;
        color: #8ab4f8;
        position: sticky;
        top: 0;
        background: #0d1b2a;
      }
      table.stats-table td {
        padding: 6px 10px;
        border-bottom: 1px solid #1a2f44;
      }
      table.stats-table tr:hover td {
        background: rgba(58, 123, 213, 0.1);
      }
      .rank-num {
        color: #666;
        width: 30px;
        display: inline-block;
        text-align: center;
      }
      .rank-1 { color: #ffd700; }
      .rank-2 { color: #c0c0c0; }
      .rank-3 { color: #cd7f32; }
      .badge-24h {
        display: inline-block;
        background: #1b5e20;
        color: #81c784;
        font-size: 0.65rem;
        padding: 1px 6px;
        border-radius: 8px;
        animation: pulse-dot 2s infinite;
      }
      .dot-live {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4caf50;
        margin-right: 6px;
        animation: pulse-dot 1.5s infinite;
      }
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }
      .color-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 4px;
        vertical-align: middle;
      }
      @media (max-width: 600px) {
        #ufoMap { height: 380px; }
        .stats-table th:nth-child(4), .stats-table td:nth-child(4) { display: none; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="map-page">
      <h1>🛸 全球 UFO/UAP 目擊熱力地圖</h1>
      <p class="subtitle">
        <span class="dot-live"></span>互動式地圖 · 可放大縮小 · 點擊各國查看UFO目擊統計 · 根據公開記錄整理
      </p>

      <div id="ufoMap"></div>
      <div class="legend">
        <span>較少</span>
        <div class="legend-bar">
          <span style="background:#1a237e"></span>
          <span style="background:#283593"></span>
          <span style="background:#3949ab"></span>
          <span style="background:#5c6bc0"></span>
          <span style="background:#7c4dff"></span>
          <span style="background:#e040fb"></span>
          <span style="background:#d500f9"></span>
          <span style="background:#aa00ff"></span>
          <span style="background:#f44336"></span>
          <span style="background:#ff1744"></span>
        </div>
        <span>較多</span>
      </div>

      <div class="stats-section">
        <h2>📊 各國 UFO 目擊統計排名</h2>
        <div class="stats-table-wrap">
          <table class="stats-table" id="statsTable">
            <thead>
              <tr>
                <th>#</th>
                <th>國家 / 地區</th>
                <th>目擊總數</th>
                <th>著名案例</th>
                <th>24h</th>
              </tr>
            </thead>
            <tbody id="statsBody"></tbody>
          </table>
        </div>
        <p style="color:#666;font-size:0.75rem;margin-top:0.8rem;">
          📋 數據來源：NUFORC、Wikipedia、各國UFO研究組織 · 🕐 持續更新
        </p>
      </div>
    </main>
    <Footer />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
    const ufoData = [
      { id:'US',name:'美國',nameEn:'United States',sightings:128450,famous:'羅斯威爾、尼米茲、鳳凰城之光',recent24h:true,lat:39.83,lng:-98.58 },
      { id:'BR',name:'巴西',nameEn:'Brazil',sightings:42500,famous:'阿拉卡茹事件、UFO浪潮',recent24h:true,lat:-14.24,lng:-51.93 },
      { id:'GB',name:'英國',nameEn:'United Kingdom',sightings:28500,famous:'倫德爾沙姆森林',recent24h:true,lat:55.38,lng:-3.44 },
      { id:'CA',name:'加拿大',nameEn:'Canada',sightings:22300,famous:'沙港事件',recent24h:true,lat:56.13,lng:-106.35 },
      { id:'AU',name:'澳洲',nameEn:'Australia',sightings:18900,famous:'Westall小學目擊',recent24h:false,lat:-25.27,lng:133.78 },
      { id:'RU',name:'俄羅斯',nameEn:'Russia',sightings:16200,famous:'蘇聯石化外星人',recent24h:false,lat:61.52,lng:105.32 },
      { id:'FR',name:'法國',nameEn:'France',sightings:14800,famous:'GEIPAN官方研究',recent24h:false,lat:46.60,lng:1.89 },
      { id:'AR',name:'阿根廷',nameEn:'Argentina',sightings:12100,famous:'阿根廷UFO黨',recent24h:false,lat:-38.42,lng:-63.62 },
      { id:'DE',name:'德國',nameEn:'Germany',sightings:11500,famous:'德國UFO研究網絡',recent24h:false,lat:51.17,lng:10.45 },
      { id:'MX',name:'墨西哥',nameEn:'Mexico',sightings:10900,famous:'空軍IR影片',recent24h:true,lat:23.63,lng:-102.55 },
      { id:'IT',name:'意大利',nameEn:'Italy',sightings:9800,famous:'CISU研究組織',recent24h:false,lat:41.87,lng:12.57 },
      { id:'JP',name:'日本',nameEn:'Japan',sightings:8700,famous:'JAL1628航班、1235年事件',recent24h:false,lat:36.20,lng:138.25 },
      { id:'CN',name:'中國',nameEn:'China',sightings:8200,famous:'古代UFO記錄、蕭山機場',recent24h:false,lat:35.86,lng:104.20 },
      { id:'IN',name:'印度',nameEn:'India',sightings:7500,famous:'印度UFO研究',recent24h:false,lat:20.59,lng:78.96 },
      { id:'ES',name:'西班牙',nameEn:'Spain',sightings:7200,famous:'西班牙UFO研究',recent24h:false,lat:40.46,lng:-3.75 },
      { id:'ZA',name:'南非',nameEn:'South Africa',sightings:6800,famous:'阿里爾學校事件',recent24h:false,lat:-30.56,lng:22.94 },
      { id:'SE',name:'瑞典',nameEn:'Sweden',sightings:6500,famous:'戴耶特海底UFO',recent24h:false,lat:60.13,lng:18.64 },
      { id:'IR',name:'伊朗',nameEn:'Iran',sightings:5900,famous:'德黑蘭F-4對峙',recent24h:false,lat:32.43,lng:53.69 },
      { id:'PE',name:'秘魯',nameEn:'Peru',sightings:5500,famous:'空軍UFO影片',recent24h:false,lat:-9.19,lng:-75.01 },
      { id:'CL',name:'智利',nameEn:'Chile',sightings:5200,famous:'CEFAA官方研究',recent24h:false,lat:-35.68,lng:-71.54 },
      { id:'PL',name:'波蘭',nameEn:'Poland',sightings:4500,famous:'波蘭UFO研究',recent24h:false,lat:51.92,lng:19.14 },
      { id:'NO',name:'挪威',nameEn:'Norway',sightings:4200,famous:'Hessdalen光球',recent24h:false,lat:60.47,lng:8.47 },
      { id:'NZ',name:'紐西蘭',nameEn:'New Zealand',sightings:3800,famous:'凱庫拉海光',recent24h:false,lat:-40.90,lng:174.89 },
      { id:'BE',name:'比利時',nameEn:'Belgium',sightings:3200,famous:'比利時UFO浪潮',recent24h:false,lat:50.85,lng:4.35 },
      { id:'PT',name:'葡萄牙',nameEn:'Portugal',sightings:2900,famous:'卡林頓目擊',recent24h:false,lat:39.40,lng:-8.22 },
      { id:'TR',name:'土耳其',nameEn:'Turkey',sightings:2600,famous:'土耳其UFO攝錄',recent24h:false,lat:38.96,lng:35.24 },
      { id:'KR',name:'韓國',nameEn:'South Korea',sightings:2300,famous:'韓國UFO研究',recent24h:false,lat:35.91,lng:127.77 },
      { id:'ZW',name:'津巴布韋',nameEn:'Zimbabwe',sightings:2100,famous:'62學童集體目擊',recent24h:false,lat:-19.02,lng:29.15 },
      { id:'HK',name:'香港',nameEn:'Hong Kong',sightings:850,famous:'香港UFO目擊記錄',recent24h:false,lat:22.32,lng:114.17 },
    ];

    const maxSightings = Math.max(...ufoData.map(d => d.sightings));

    function getColor(value) {
      const r = value / maxSightings;
      if (r < 0.02) return '#1a237e';
      if (r < 0.05) return '#283593';
      if (r < 0.10) return '#3949ab';
      if (r < 0.15) return '#5c6bc0';
      if (r < 0.20) return '#7c4dff';
      if (r < 0.30) return '#e040fb';
      if (r < 0.40) return '#d500f9';
      if (r < 0.60) return '#aa00ff';
      if (r < 0.80) return '#f44336';
      return '#ff1744';
    }

    // Initialize map
    const map = L.map('ufoMap', {
      center: [20, 0],
      zoom: 2,
      minZoom: 1,
      maxZoom: 6,
      zoomControl: true,
      worldCopyJump: true
    });

    // Add dark tiles
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19
    }).addTo(map);

    // Add circles
    ufoData.forEach(country => {
      const radius = Math.max(8, Math.sqrt(country.sightings / maxSightings) * 40);
      const color = getColor(country.sightings);
      const popupHtml = `
        <div class="popup-content">
          <div class="country-name">${country.name} (${country.nameEn})</div>
          <div class="stat"><span class="stat-label">👁️ 目擊總數</span><span class="stat-val">${country.sightings.toLocaleString()}</span></div>
          <div class="stat"><span class="stat-label">🏆 著名案例</span><span style="color:#ccc;">${country.famous}</span></div>
          ${country.recent24h ? '<div class="recent-badge">🔴 過去24小時有新報告</div>' : ''}
        </div>
      `;

      const circle = L.circleMarker([country.lat, country.lng], {
        radius: radius,
        fillColor: color,
        color: '#fff',
        weight: 1,
        opacity: 0.6,
        fillOpacity: 0.75
      }).addTo(map);

      circle.bindPopup(popupHtml, {
        className: 'custom-popup',
        maxWidth: 280
      });

      circle.on('mouseover', function() {
        this.setStyle({ fillOpacity: 1, weight: 2, opacity: 1 });
      });
      circle.on('mouseout', function() {
        this.setStyle({ fillOpacity: 0.75, weight: 1, opacity: 0.6 });
      });
    });

    // Stats table
    const sorted = [...ufoData].sort((a, b) => b.sightings - a.sightings);
    const tbody = document.getElementById('statsBody');
    sorted.forEach((c, i) => {
      const tr = document.createElement('tr');
      const rankClass = i < 3 ? `rank-${i + 1}` : '';
      const color = getColor(c.sightings);
      tr.innerHTML = `
        <td><span class="rank-num ${rankClass}">${i + 1}</span></td>
        <td><span class="color-dot" style="background:${color}"></span>${c.name}</td>
        <td><strong>${c.sightings.toLocaleString()}</strong></td>
        <td style="font-size:0.8rem;color:#999">${c.famous}</td>
        <td>${c.recent24h ? '<span class="badge-24h">🔴</span>' : '<span style="color:#555">—</span>'}</td>
      `;
      tr.addEventListener('click', () => {
        map.setView([c.lat, c.lng], 4, { animate: true });
        // Trigger click on circle
        map.eachLayer(layer => {
          if (layer instanceof L.CircleMarker) {
            const llng = Math.round(layer.getLatLng().lng * 100) / 100;
            const clng = Math.round(c.lng * 100) / 100;
            if (llng === clng) {
              layer.openPopup();
            }
          }
        });
      });
      tr.style.cursor = 'pointer';
      tbody.appendChild(tr);
    });

    // Add glow ring to recent24h countries
    ufoData.filter(c => c.recent24h).forEach(country => {
      const ring = L.circleMarker([country.lat, country.lng], {
        radius: Math.max(8, Math.sqrt(country.sightings / maxSightings) * 40) + 4,
        color: '#4caf50',
        fillColor: 'transparent',
        fillOpacity: 0,
        weight: 2,
        opacity: 0.5
      }).addTo(map);
      
      // Animate ring
      let growing = true;
      setInterval(() => {
        const r = ring.getRadius();
        const baseR = Math.max(8, Math.sqrt(country.sightings / maxSightings) * 40) + 4;
        if (growing) {
          ring.setRadius(r + 0.3);
          ring.setStyle({ opacity: 0.6 - (r - baseR) / 20 });
          if (r - baseR > 12) growing = false;
        } else {
          ring.setRadius(r - 0.3);
          ring.setStyle({ opacity: 0.2 + (r - baseR) / 20 });
          if (r - baseR < 0) growing = true;
        }
      }, 50);
    });

    // Add flying UFO emoji animation at random intervals
    function spawnUfo() {
      const el = document.createElement('div');
      el.textContent = '🛸';
      el.style.cssText = 'position:fixed;pointer-events:none;font-size:1.2rem;z-index:9999;transition:all 2s ease-in-out;opacity:0;';
      const startX = Math.random() * window.innerWidth;
      const startY = Math.random() * window.innerHeight * 0.3;
      el.style.left = startX + 'px';
      el.style.top = startY + 'px';
      document.body.appendChild(el);
      
      setTimeout(() => {
        el.style.opacity = '0.7';
        el.style.transform = 'translateY(-30px) rotate(10deg)';
      }, 50);
      
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-60px) rotate(-10deg) scale(1.3)';
      }, 1800);
      
      setTimeout(() => el.remove(), 2500);
    }
    
    setInterval(spawnUfo, 8000);
    // Spawn one immediately
    setTimeout(spawnUfo, 1000);
    setTimeout(spawnUfo, 3000);
    setTimeout(spawnUfo, 5000);
    </script>
  </body>
</html>
