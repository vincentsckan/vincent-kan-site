---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { useTranslations, getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title="About — Davis Kan" description={t('about.bio')} />
  </head>
  <body>
    <Header />
    <main>
      <article class="about-page">
        <header class="page-header">
          <h1>{t('about.title')}</h1>
        </header>

        <div class="about-layout">
          <div class="about-main">
            <h2>Davis Kan</h2>
            <p class="about-location">📍 Hong Kong</p>
            <div class="about-bio">
              <p>Tech enthusiast, AI hobbyist, and UFO/UAP researcher. I love exploring new technology and building automation tools to make life easier.</p>
              <p>I believe transparency is key to UAP disclosure. Currently researching AI automation and global UFO news monitoring systems.</p>
            </div>
            <div class="about-contact">
              <span class="skill-badge">vincentsc.kan@gmail.com</span>
              <span class="skill-badge">Telegram / WhatsApp</span>
            </div>
          </div>
          <aside class="about-sidebar">
            <div class="card">
              <h3>{t('about.interests')}</h3>
              <ul class="interest-list">
                <li><strong>AI & Automation</strong> — LLMs, AI agents</li>
                <li><strong>UFO/UAP</strong> — Global news tracking</li>
                <li><strong>Web Dev</strong> — Astro, React</li>
                <li><strong>Linux</strong> — Servers, DevOps</li>
                <li><strong>Data</strong> — Pipelines, scraping</li>
              </ul>
            </div>
          </aside>
        </div>
      </article>
    </main>
    <Footer />

    <style>
      .page-header { margin-bottom: 2.5rem; }
      .page-header h1 { font-size: 2rem; }

      .about-layout {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2rem;
        align-items: start;
      }
      .about-main h2 { font-size: 1.6rem; margin-bottom: 0.25rem; }
      .about-location { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.2rem; }
      .about-bio p { margin-bottom: 0.75rem; font-size: 0.95rem; }
      .about-contact { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
      .about-sidebar h3 { font-size: 1rem; margin-bottom: 1rem; }
      .interest-list { list-style: none; padding: 0; }
      .interest-list li { padding: 0.5rem 0; font-size: 0.88rem; border-bottom: 1px solid var(--border); color: var(--text-secondary); }
      .interest-list li:last-child { border-bottom: none; }
      .interest-list li strong { color: var(--text); }
      @media (max-width: 768px) { .about-layout { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
