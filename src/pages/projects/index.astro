---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={`Projects — ${SITE_TITLE}`} description="Vincent Kan's project portfolio" />
  </head>
  <body>
    <Header />
    <main>
      <div class="page-banner">
        <img src="/ufo-banner-projects.svg" alt="UFO Banner" />
      </div>
      <header class="page-header">
        <h1>Projects</h1>
        <p class="page-desc">Things I'm working on and have built</p>
      </header>

      <div class="projects-list">
        <article class="card project-full">
          <div class="p-row">
            <span class="p-icon">🤖</span>
            <div class="p-body">
              <div class="p-head">
                <h2>𠎀克森</h2>
                <span class="p-status active">Active</span>
              </div>
              <p>Personal AI assistant running 24/7. Handles daily tasks, automated monitoring, UFO intel tracking. Supports both Telegram and WhatsApp channels.</p>
              <div class="tags">
                <span class="tag">AI</span>
                <span class="tag">Automation</span>
                <span class="tag">Node.js</span>
              </div>
            </div>
          </div>
        </article>

        <article class="card project-full">
          <div class="p-row">
            <span class="p-icon">🛸</span>
            <div class="p-body">
              <div class="p-head">
                <h2>UAP Briefing System</h2>
                <span class="p-status active">Active</span>
              </div>
              <p>Auto-collects global UFO/UAP news, AI-powered analysis, scheduled push to WhatsApp/Telegram.</p>
              <div class="tags">
                <span class="tag">Data Pipeline</span>
                <span class="tag">AI</span>
                <span class="tag">Automation</span>
              </div>
            </div>
          </div>
        </article>

        <article class="card project-full">
          <div class="p-row">
            <span class="p-icon">🌐</span>
            <div class="p-body">
              <div class="p-head">
                <h2>Vincent Site</h2>
                <span class="p-status active">Active</span>
              </div>
              <p>This website — an Astro-built personal site + blog. Clean design, static site, fast loading.</p>
              <div class="tags">
                <span class="tag">Astro</span>
                <span class="tag">Web Dev</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </main>
    <Footer />

    <style>
      .page-banner {
        width: 100%;
        height: 160px;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #0a0a2e 0%, #1a1a4e 50%, #2a1a3e 100%);
      }
      .page-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .page-header { margin-bottom: 2.5rem; }
      .page-header h1 { font-size: 2rem; }
      .page-desc { color: var(--text-muted); margin-top: 0.3rem; }

      .projects-list { display: flex; flex-direction: column; gap: 1rem; }
      .p-row { display: flex; gap: 1.25rem; align-items: flex-start; }
      .p-icon { font-size: 1.6rem; line-height: 1; }
      .p-body { flex: 1; }
      .p-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
      .p-head h2 { margin: 0; font-size: 1.15rem; }
      .p-status { font-size: 0.78rem; font-weight: 600; }
      .p-status.active { color: #16a34a; }
      .project-full p { font-size: 0.9rem; margin-bottom: 0; }
      .project-full .tags { margin-top: 0.8rem; }

      @media (max-width: 600px) {
        .p-row { flex-direction: column; gap: 0.5rem; }
      }
    </style>
  </body>
</html>
