---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!DOCTYPE html>
<html lang="zh-HK">
  <head>
    <BaseHead title={`專案 — ${SITE_TITLE}`} description="Vincent Kan 嘅專案作品" />
  </head>
  <body>
    <Header />
    <main>
      <header class="page-header">
        <h1>專案</h1>
        <p class="page-desc">我正在做同做過嘅專案</p>
      </header>

      <div class="projects-list">
        <article class="card project-full">
          <div class="p-row">
            <span class="p-icon">🤖</span>
            <div class="p-body">
              <div class="p-head">
                <h2>𠎀克森</h2>
                <span class="p-status active">進行中</span>
              </div>
              <p>個人 AI 助手，7x24 運行。處理日常工作、自動監控、UFO 資訊追蹤。支援 Telegram 同 WhatsApp 雙通道。</p>
              <div class="tags">
                <span class="tag">AI</span>
                <span class="tag">自動化</span>
                <span class="tag">Node.js</span>
              </div>
            </div>
          </div>
        </article>

        <article class="card project-full">
          <div class="p-row">
            <span class="p-icon">🛸</span>
            <div class="p-body">
              <div class="p-head">
                <h2>UAP 簡報系統</h2>
                <span class="p-status active">進行中</span>
              </div>
              <p>自動搜集全球 UFO/UAP 新聞，AI 整合分析，定時推送 WhatsApp/Telegram。</p>
              <div class="tags">
                <span class="tag">數據管線</span>
                <span class="tag">AI</span>
                <span class="tag">自動化</span>
              </div>
            </div>
          </div>
        </article>

        <article class="card project-full">
          <div class="p-row">
            <span class="p-icon">🌐</span>
            <div class="p-body">
              <div class="p-head">
                <h2>Vincent Site</h2>
                <span class="p-status active">進行中</span>
              </div>
              <p>呢個網站 — Astro 搭建嘅個人網站 + 網誌。簡潔設計、靜態網站、快速載入。</p>
              <div class="tags">
                <span class="tag">Astro</span>
                <span class="tag">網站開發</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </main>
    <Footer />

    <style>
      .page-header { margin-bottom: 2.5rem; }
      .page-header h1 { font-size: 2rem; }
      .page-desc { color: var(--text-muted); margin-top: 0.3rem; }

      .projects-list { display: flex; flex-direction: column; gap: 1rem; }
      .p-row { display: flex; gap: 1.25rem; align-items: flex-start; }
      .p-icon { font-size: 1.6rem; line-height: 1; }
      .p-body { flex: 1; }
      .p-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
      .p-head h2 { margin: 0; font-size: 1.15rem; }
      .p-status { font-size: 0.78rem; font-weight: 600; }
      .p-status.active { color: #16a34a; }
      .project-full p { font-size: 0.9rem; margin-bottom: 0; }
      .project-full .tags { margin-top: 0.8rem; }

      @media (max-width: 600px) {
        .p-row { flex-direction: column; gap: 0.5rem; }
      }
    </style>
  </body>
</html>
