---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="zh-HK">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
      <!-- 🏆 Hero Section with Sci-Fi Background -->
      <section class="hero">
        <div class="hero-canvas" id="heroCanvas"></div>
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            Vincent Kan
          </div>
          <h1>
            科技愛好者<span class="text-gradient">·</span><br />
            解構神秘 ·<br />
            <span class="text-gradient">AI 玩家</span>
          </h1>
          <p class="hero-desc">
            香港。探索科技前沿、解構神秘現象，用 AI 同 automation 
            令生活更高效。呢度記錄咗我嘅 side projects、研究同 UFO/UAP 探索。
          </p>
          <div class="hero-actions">
            <a href="/vincent-kan-site/about" class="btn btn-primary">
              關於我
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="/vincent-kan-site/projects" class="btn btn-outline">
              睇 Projects
            </a>
          </div>
        </div>
      </section>

      <!-- 📊 Stats Bar -->
      <section class="stats-bar">
        <div class="stat-item">
          <span class="stat-number">3+</span>
          <span class="stat-label">Active Projects</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">8</span>
          <span class="stat-label">Technologies</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">7×24</span>
          <span class="stat-label">AI Assistant</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">∞</span>
          <span class="stat-label">Curiosity</span>
        </div>
      </section>

      <!-- ⚡ Skills -->
      <section class="section">
        <div class="section-header">
          <h2>
            <span class="section-number">01</span>
            Tech Stack
          </h2>
        </div>
        <div class="skills-grid">
          <div class="skill-category">
            <h3>🤖 AI & Data</h3>
            <div class="skills">
              <span class="skill-badge">AI / LLM</span>
              <span class="skill-badge">Data Pipeline</span>
              <span class="skill-badge">UAP Research</span>
            </div>
          </div>
          <div class="skill-category">
            <h3>💻 Development</h3>
            <div class="skills">
              <span class="skill-badge">Python</span>
              <span class="skill-badge">React</span>
              <span class="skill-badge">Astro</span>
              <span class="skill-badge">Node.js</span>
            </div>
          </div>
          <div class="skill-category">
            <h3>☁️ Infrastructure</h3>
            <div class="skills">
              <span class="skill-badge">Linux / DevOps</span>
              <span class="skill-badge">Docker</span>
              <span class="skill-badge">Nginx</span>
              <span class="skill-badge">Cloud</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 📂 Featured Projects -->
      <section class="section">
        <div class="section-header">
          <h2>
            <span class="section-number">02</span>
            Featured Projects
          </h2>
          <a href="/vincent-kan-site/projects" class="section-link">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="project-grid">
          <article class="card project-card">
            <div class="project-card-top">
              <div class="project-icon">🤖</div>
              <span class="project-status active">Active</span>
            </div>
            <h3>Robot Key</h3>
            <p>7×24 AI 助手，處理日常 tasks、系統監控、UFO 資訊追蹤。</p>
            <div class="project-tags">
              <span class="tag">AI</span>
              <span class="tag">Automation</span>
              <span class="tag">7×24</span>
            </div>
          </article>
          <article class="card project-card">
            <div class="project-card-top">
              <div class="project-icon">🛸</div>
              <span class="project-status active">Active</span>
            </div>
            <h3>UAP 簡報系統</h3>
            <p>全球 UFO/UAP 新聞自動搜集、AI 分析摘要、定時推送。</p>
            <div class="project-tags">
              <span class="tag">Data</span>
              <span class="tag">Automation</span>
              <span class="tag">AI</span>
            </div>
          </article>
          <article class="card project-card">
            <div class="project-card-top">
              <div class="project-icon">🌐</div>
              <span class="project-status active">Active</span>
            </div>
            <h3>Vincent Site</h3>
            <p>呢個網站 — Astro static site，現代簡潔設計。</p>
            <div class="project-tags">
              <span class="tag">Astro</span>
              <span class="tag">Web Dev</span>
              <span class="tag">Design</span>
            </div>
          </article>
        </div>
      </section>

      <!-- 📝 Latest Blog -->
      <section class="section">
        <div class="section-header">
          <h2>
            <span class="section-number">03</span>
            Latest Blog
          </h2>
          <a href="/vincent-kan-site/blog" class="section-link">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="blog-placeholder card">
          <div class="blog-placeholder-icon">📝</div>
          <p>文章準備中 — 即將上線</p>
          <span class="blog-placeholder-sub">敬請期待</span>
        </div>
      </section>

      <!-- 🚀 CTA -->
      <section class="cta-section">
        <div class="cta-card">
          <h2>Let's Connect</h2>
          <p>有興趣合作、交流技術，或者傾下 UFO？隨時搵我。</p>
          <a href="/vincent-kan-site/about" class="btn btn-primary">
            了解更多
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* ===== HERO ===== */
      .hero {
        padding: 6rem 0 3rem;
        text-align: center;
        position: relative;
        overflow: hidden;
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hero-canvas {
        position: absolute;
        inset: 0;
        z-index: 0;
      }
      .hero-content {
        position: relative;
        z-index: 1;
      }
      .hero::before {
        content: '';
        position: absolute;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(79,70,229,0.06) 0%, transparent 70%);
        pointer-events: none;
      }
      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--accent-light);
        color: var(--accent-dark);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.35rem 1rem;
        border-radius: 100px;
        margin-bottom: 2rem;
      }
      .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        display: inline-block;
      }
      .hero h1 {
        font-size: 3.2rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 1.5rem;
        letter-spacing: -0.03em;
      }
      .hero-desc {
        font-size: 1.1rem;
        color: var(--text-secondary);
        max-width: 580px;
        margin: 0 auto 2rem;
        line-height: 1.7;
      }
      .hero-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* ===== STATS BAR ===== */
      .stats-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.5rem 2rem;
        margin: 0 auto;
        max-width: 700px;
      }
      .stat-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0 1rem;
      }
      .stat-number {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.02em;
      }
      .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .stat-divider {
        width: 1px;
        height: 40px;
        background: var(--border);
      }

      /* ===== SKILLS ===== */
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }
      .skill-category {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.5rem;
      }
      .skill-category h3 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text);
      }
      .skill-category .skills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }

      /* ===== PROJECT CARDS ===== */
      .project-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }
      .project-card { 
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
      }
      .project-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }
      .project-icon { 
        font-size: 2rem; 
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-light);
        border-radius: var(--radius-sm);
      }
      .project-status {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
        border-radius: 100px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .project-status.active {
        background: #dcfce7;
        color: #166534;
      }
      .project-card h3 { 
        font-size: 1.1rem; 
        margin-bottom: 0.5rem;
        font-weight: 600;
      }
      .project-card p { 
        font-size: 0.88rem; 
        margin-bottom: 0;
        flex: 1;
        color: var(--text-secondary);
      }
      .project-tags { margin-top: 1rem; }

      /* ===== BLOG PLACEHOLDER ===== */
      .blog-placeholder {
        text-align: center;
        padding: 3rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }
      .blog-placeholder-icon {
        font-size: 2.5rem;
        margin-bottom: 0.25rem;
      }
      .blog-placeholder p { 
        margin: 0; 
        color: var(--text-secondary);
        font-size: 1rem;
        font-weight: 500;
      }
      .blog-placeholder-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      /* ===== CTA ===== */
      .cta-section {
        margin: 6rem 0;
      }
      .cta-card {
        background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
        border: 1px solid var(--accent-light);
        border-radius: var(--radius);
        padding: 3.5rem 2rem;
        text-align: center;
      }
      .cta-card h2 {
        font-size: 1.8rem;
        margin-bottom: 0.75rem;
      }
      .cta-card p {
        max-width: 400px;
        margin: 0 auto 1.5rem;
        color: var(--text-secondary);
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 900px) {
        .skills-grid,
        .project-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 640px) {
        .hero { padding: 4rem 0 2rem; min-height: 80vh; }
        .hero h1 { font-size: 2rem; }
        .hero::before { width: 300px; height: 300px; }

        .stats-bar {
          flex-wrap: wrap;
          padding: 1rem;
          gap: 0.5rem;
        }
        .stat-item { padding: 0.5rem; min-width: 80px; }
        .stat-number { font-size: 1.3rem; }
        .stat-divider { display: none; }

        .skills-grid,
        .project-grid {
          grid-template-columns: 1fr;
        }

        .cta-card { padding: 2.5rem 1.5rem; }
      }
    </style>

    <script>
    (function() {
      const canvas = document.getElementById('heroCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w, h, stars = [], ufos = [], particles = [];
      
      function resize() {
        const hero = canvas.parentElement;
        w = canvas.width = hero.offsetWidth;
        h = canvas.height = hero.offsetHeight;
      }
      
      // Stars
      class Star {
        constructor() { this.reset(); this.y = Math.random() * h; }
        reset() {
          this.x = Math.random() * w;
          this.y = 0;
          this.size = Math.random() * 2 + 0.5;
          this.speed = Math.random() * 0.3 + 0.1;
          this.opacity = Math.random() * 0.6 + 0.2;
          this.twinkleSpeed = Math.random() * 0.02 + 0.005;
          this.twinklePhase = Math.random() * Math.PI * 2;
        }
        update() {
          this.y += this.speed;
          if (this.y > h) this.reset();
          this.currentOpacity = this.opacity * (0.6 + 0.4 * Math.sin(this.twinklePhase));
          this.twinklePhase += this.twinkleSpeed;
        }
        draw() {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${this.currentOpacity})`;
          ctx.fill();
        }
      }
      
      // UFOs (shooting stars / orbs)
      class UFO {
        constructor() {
          this.reset(true);
        }
        reset(initial = false) {
          this.x = initial ? Math.random() * w : w + 50;
          this.y = Math.random() * h * 0.6 + 20;
          this.speed = Math.random() * 1.5 + 0.5;
          this.size = Math.random() * 3 + 2;
          this.hue = Math.random() * 60 + 180; // teal/cyan to blue
          this.wait = Math.random() * 300 + 200;
          this.counter = 0;
        }
        update() {
          this.counter++;
          if (this.counter < this.wait && this.x > w * 0.8) return;
          this.x -= this.speed * 0.3;
          this.y += Math.sin(this.counter * 0.02) * 0.2;
          if (this.x < -20) this.reset();
        }
        draw() {
          const alpha = Math.min(1, Math.max(0.1, 1 - (w - this.x) / w * 0.8));
          // Glow
          const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size * 6);
          grad.addColorStop(0, `hsla(${this.hue}, 80%, 70%, ${alpha * 0.3})`);
          grad.addColorStop(1, `hsla(${this.hue}, 80%, 70%, 0)`);
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size * 6, 0, Math.PI * 2);
          ctx.fill();
          // Core
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fillStyle = `hsla(${this.hue}, 90%, 80%, ${alpha * 0.9})`;
          ctx.fill();
          // Light trail
          ctx.beginPath();
          ctx.moveTo(this.x, this.y);
          ctx.lineTo(this.x + this.size * 3, this.y - this.size * 0.3);
          ctx.strokeStyle = `hsla(${this.hue}, 80%, 70%, ${alpha * 0.3})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }
      
      // Atmospheric particles
      class Particle {
        constructor() {
          this.reset(true);
        }
        reset(initial = false) {
          this.x = Math.random() * w;
          this.y = initial ? Math.random() * h : h + 5;
          this.size = Math.random() * 1.5 + 0.3;
          this.speed = Math.random() * 0.15 + 0.05;
          this.drift = Math.random() * 0.2 - 0.1;
          this.opacity = Math.random() * 0.3 + 0.05;
        }
        update() {
          this.y -= this.speed;
          this.x += this.drift;
          if (this.y < -5 || this.x < -5 || this.x > w + 5) this.reset();
        }
        draw() {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(150, 180, 255, ${this.opacity})`;
          ctx.fill();
        }
      }
      
      function init() {
        resize();
        const count = Math.floor((w * h) / 8000);
        stars = Array.from({ length: count }, () => new Star());
        ufos = Array.from({ length: 3 }, () => new UFO());
        particles = Array.from({ length: 20 }, () => new Particle());
      }
      
      function animate() {
        ctx.clearRect(0, 0, w, h);
        stars.forEach(s => { s.update(); s.draw(); });
        particles.forEach(p => { p.update(); p.draw(); });
        ufos.forEach(u => { u.update(); u.draw(); });
        requestAnimationFrame(animate);
      }
      
      init();
      animate();
      window.addEventListener('resize', resize);
    })();
    </script>
  </body>
</html>
