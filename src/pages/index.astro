---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);
const uapPosts = posts.filter(p => p.id.startsWith('ufo-')).slice(0, 5);
---

<!DOCTYPE html>
<html lang="zh-HK">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:inline>
@keyframes twinkle {
  0%,100%{opacity:0.15;transform:scale(.8)}
  50%{opacity:.8;transform:scale(1.2)}
}
@keyframes drift {
  0%{transform:translate(100vw,10vh);opacity:0}
  10%{opacity:.4}
  90%{opacity:.4}
  100%{transform:translate(-20vw,60vh);opacity:0}
}
@keyframes floatUp {
  0%{transform:translateY(100vh);opacity:0}
  10%{opacity:.6}
  90%{opacity:.6}
  100%{transform:translateY(-10vh);opacity:0}
}
.hero-stars{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.star{position:absolute;width:2px;height:2px;background:#fff;border-radius:50%;animation:twinkle var(--d,4s) ease-in-out infinite;animation-delay:var(--dd,0s)}
.star.big{width:3px;height:3px}
.orb{position:absolute;width:6px;height:6px;border-radius:50%;opacity:0;animation:drift var(--d,30s) linear infinite;animation-delay:var(--dd,0s)}
.orb.c1{background:radial-gradient(circle at 30% 30%,#7dd3fc,#06b6d4);box-shadow:0 0 16px 6px rgba(6,182,212,.25)}
.orb.c2{background:radial-gradient(circle at 30% 30%,#f0abfc,#c026d3);box-shadow:0 0 12px 5px rgba(192,38,211,.2);width:5px;height:5px}
.bubble{position:absolute;width:4px;height:4px;border-radius:50%;background:rgba(150,200,255,.12);opacity:0;animation:floatUp var(--d,20s) linear infinite;animation-delay:var(--dd,0s)}
    </style>
    <style>
hr{border:none;border-top:1px solid var(--border);margin:2.5rem 0}
.section-title{font-size:1.6rem;font-weight:700;margin-bottom:1.5rem;letter-spacing:-.02em}
.section-sub{margin-top:-1rem;margin-bottom:2rem;color:var(--text-muted);font-size:.9rem}
/* --- Hero --- */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:2rem 1.5rem 4rem;position:relative}
.hero h1{font-size:clamp(2rem,5vw,3.5rem);font-weight:800;line-height:1.15;margin-bottom:1rem;letter-spacing:-.03em}
.hero p{font-size:1.05rem;color:var(--text-secondary);max-width:500px;margin-bottom:2rem;line-height:1.7}
.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center}
.hero-scroll{margin-top:2rem;font-size:.8rem;color:var(--text-muted);animation:twinkle 2s ease-in-out infinite}
/* --- Feed --- */
.feed{max-width:680px;margin:0 auto;padding:0 1.5rem 4rem}
.feed-item{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;transition:opacity .15s}
.feed-item:hover{opacity:.7}
.feed-item:last-child{border-bottom:none}
.feed-icon{flex-shrink:0;width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:var(--bg-secondary);border-radius:50%;font-size:1.1rem}
.feed-body{flex:1;min-width:0}
.feed-meta{display:flex;gap:.5rem;font-size:.75rem;color:var(--text-muted);margin-bottom:.15rem}
.feed-tag{font-weight:600}
.feed-tag.uap{color:#0891b2}
.feed-tag.tech{color:#7c3aed}
.feed-tag.research{color:#059669}
.feed-body h3{font-size:.95rem;font-weight:600;margin:0 0 .15rem;line-height:1.4}
.feed-body p{font-size:.85rem;color:var(--text-secondary);margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.feed-time{flex-shrink:0;font-size:.75rem;color:var(--text-muted)}
/* --- Sections --- */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.card{background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;transition:transform .15s}
.card:hover{transform:translateY(-2px)}
.card-icon{font-size:1.5rem;margin-bottom:.5rem}
.card h3{font-size:.95rem;font-weight:600;margin-bottom:.25rem}
.card p{font-size:.82rem;color:var(--text-secondary);margin:0;line-height:1.6}
.badge{display:inline-block;font-size:.7rem;font-weight:600;padding:.15rem .5rem;border-radius:100px;text-transform:uppercase;letter-spacing:.04em}
.badge.active{background:#dcfce7;color:#166534}
/* --- CTA --- */
.cta{text-align:center;padding:3rem 0;margin-top:2rem}
.cta p{color:var(--text-secondary);margin-bottom:1.25rem}
@media(max-width:640px){
  .grid3{grid-template-columns:1fr}
  .feed{padding:0 1rem 3rem}
  .hero{padding:2rem 1rem 3rem}
}
    </style>
  </head>
  <body>
    <Header />
    <div class="hero-stars">
      <div class="star" style="top:8%;left:12%;--d:3.2s;--dd:.1s"></div>
      <div class="star" style="top:15%;left:45%;--d:2.8s;--dd:1.3s"></div>
      <div class="star big" style="top:22%;left:78%;--d:4s;--dd:.5s"></div>
      <div class="star" style="top:30%;left:25%;--d:3.5s;--dd:2s"></div>
      <div class="star big" style="top:38%;left:60%;--d:3s;--dd:.8s"></div>
      <div class="star" style="top:45%;left:5%;--d:2.5s;--dd:3s"></div>
      <div class="star" style="top:52%;left:35%;--d:3.8s;--dd:1.8s"></div>
      <div class="star big" style="top:60%;left:70%;--d:4.2s;--dd:.3s"></div>
      <div class="star" style="top:68%;left:15%;--d:2.6s;--dd:2.5s"></div>
      <div class="star" style="top:75%;left:50%;--d:3.1s;--dd:1s"></div>
      <div class="star" style="top:82%;left:85%;--d:3.6s;--dd:2.2s"></div>
      <div class="star big" style="top:88%;left:30%;--d:3.4s;--dd:.6s"></div>
      <div class="star" style="top:93%;left:65%;--d:2.9s;--dd:1.5s"></div>
      <div class="star" style="top:98%;left:10%;--d:4.1s;--dd:3.2s"></div>
      <!-- Orbs -->
      <div class="orb c1" style="top:15%;--d:28s;--dd:0s"></div>
      <div class="orb c2" style="top:40%;--d:35s;--dd:-12s"></div>
      <div class="orb c1" style="top:65%;--d:32s;--dd:-22s"></div>
      <!-- Bubbles -->
      <div class="bubble" style="left:8%;--d:18s;--dd:0s"></div>
      <div class="bubble" style="left:25%;--d:22s;--dd:-5s"></div>
      <div class="bubble" style="left:45%;--d:15s;--dd:-10s"></div>
      <div class="bubble" style="left:65%;--d:20s;--dd:-3s"></div>
      <div class="bubble" style="left:85%;--d:17s;--dd:-8s"></div>
    </div>

    <main>
      <!-- ===== HERO ===== -->
      <section class="hero">
        <h1>
          科技愛好者 · 解構神秘<br>
          <span style="background:linear-gradient(135deg,#06b6d4,#7c3aed,#eab308);-webkit-background-clip:text;-webkit-text-fill-color:transparent">AI 玩家</span>
        </h1>
        <p>香港。用 AI automation 探索科技前沿、解構 UFO/UAP 神秘現象</p>
        <div class="hero-actions">
          <a href="/vincent-kan-site/blog" class="btn btn-primary">最新 UFO 新聞 🛸</a>
          <a href="/vincent-kan-site/projects" class="btn btn-outline">Projects</a>
        </div>
        <div class="hero-scroll">↓ scroll for latest</div>
      </section>

      <!-- ===== LATEST FEED ===== -->
      <section class="feed">
        <h2 class="section-title">📡 最新動態</h2>
        <p class="section-sub">UFO/UAP 新聞 · AI 實驗 · 深度研究</p>

        {uapPosts.slice(0, 3).map(p => (
          <a href={`/vincent-kan-site/blog/${p.id}/`} class="feed-item">
            <div class="feed-icon">🛸</div>
            <div class="feed-body">
              <div class="feed-meta">
                <span class="feed-tag uap">UFO/UAP</span>
                <span><FormattedDate date={p.data.pubDate} /></span>
              </div>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </div>
            <div class="feed-time"><FormattedDate date={p.data.pubDate} /></div>
          </a>
        ))}

        {latest.filter(p => !p.id.startsWith('ufo-')).slice(0, 2).map(p => (
          <a href={`/vincent-kan-site/blog/${p.id}/`} class="feed-item">
            <div class="feed-icon">📝</div>
            <div class="feed-body">
              <div class="feed-meta">
                <span class="feed-tag tech">Blog</span>
                <span><FormattedDate date={p.data.pubDate} /></span>
              </div>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </div>
            <div class="feed-time"><FormattedDate date={p.data.pubDate} /></div>
          </a>
        ))}

        <div style="text-align:center;margin-top:1.5rem">
          <a href="/vincent-kan-site/blog" class="btn btn-outline" style="font-size:.9rem">睇所有文章 →</a>
        </div>
      </section>

      <div class="feed">
        <hr>

        <!-- ===== WHAT I DO ===== -->
        <h2 class="section-title">🔭 我嘅 focus</h2>
        <div class="grid3">
          <div class="card">
            <div class="card-icon">🛸</div>
            <h3>每日 UAP 追蹤</h3>
            <p>AI 自動搜集全球 UFO 新聞 — 政府披露、懸案分析、科學研究</p>
          </div>
          <div class="card">
            <div class="card-icon">🤖</div>
            <h3>AI Automation</h3>
            <p>用 AI agent 處理日常 tasks、系統監控、做研究 — 7×24</p>
          </div>
          <div class="card">
            <div class="card-icon">🧪</div>
            <h3>神秘解構</h3>
            <p>深挖 UAP 案例、交叉驗證資料、整理開放數據</p>
          </div>
        </div>

        <hr>

        <!-- ===== ACTIVE PROJECTS ===== -->
        <h2 class="section-title">⚡ Projects</h2>
        <div class="grid3">
          <div class="card">
            <div class="card-icon">🤖<span class="badge active" style="margin-left:.5rem">Active</span></div>
            <h3>Robot Key</h3>
            <p>7×24 AI 助手，UFO 資訊追蹤、系統監控、日常 automation</p>
          </div>
          <div class="card">
            <div class="card-icon">🛸<span class="badge active" style="margin-left:.5rem">Active</span></div>
            <h3>UAP 簡報系統</h3>
            <p>全球 UFO 新聞自動搜集 + AI 摘要 + 每日推送</p>
          </div>
          <div class="card">
            <div class="card-icon">🌐<span class="badge active" style="margin-left:.5rem">Active</span></div>
            <h3>Vincent Site</h3>
            <p>呢個網站 — Astro static site，現代簡潔設計</p>
          </div>
        </div>

        <hr>

        <!-- ===== CTA ===== -->
        <div class="cta">
          <h2 class="section-title">📬 有嘢想傾？</h2>
          <p>UFO 神秘現象、AI 技術、或者就咁吹水都得</p>
          <a href="/vincent-kan-site/about" class="btn btn-primary">關於我</a>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>