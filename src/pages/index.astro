---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const uapPosts = posts.filter(p => p.id.startsWith('ufo-')).slice(0, 6);
const otherPosts = posts.filter(p => !p.id.startsWith('ufo-')).slice(0, 4);
const latestUAP = uapPosts[0];
const featuredUAP = uapPosts.slice(1, 4);
---

<!DOCTYPE html>
<html lang="zh-HK">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:inline>
@keyframes fadeIn { 0%{opacity:0} 100%{opacity:1} }
@keyframes slideUp { 0%{transform:translateY(15px);opacity:0} 100%{transform:translateY(0);opacity:1} }
@keyframes pulseDot { 0%,100%{opacity:1} 50%{opacity:0.3} }
@keyframes radarRing { 0%{transform:scale(.5);opacity:.6} 100%{transform:scale(2.5);opacity:0} }
@keyframes glowPulse { 0%,100%{box-shadow:0 0 8px rgba(0,229,255,0.2)} 50%{box-shadow:0 0 25px rgba(0,229,255,0.4)} }
    </style>
    <style>
      /* ===== LAYOUT ===== */
      .home-wrap { max-width: 860px; margin: 0 auto; padding: 0 1.5rem; }
      
      /* ===== BREAKING BANNER ===== */
      .breaking {
        display: flex; gap: 0.75rem; align-items: center;
        padding: 0.7rem 1rem;
        border: 1px solid rgba(239,68,68,0.15);
        border-radius: var(--radius-sm);
        background: rgba(239,68,68,0.04);
        margin-bottom: 1.5rem; margin-top: 1rem;
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: slideUp 0.6s ease both;
      }
      .breaking:hover { border-color: rgba(239,68,68,0.3); }
      .breaking-dot { width: 8px; height: 8px; background: #ef4444; border-radius: 50%; flex-shrink: 0; animation: pulseDot 1.5s infinite; }
      .breaking-label { font-family:'SF Mono',monospace; font-size:0.68rem; color:#ef4444; font-weight:600; letter-spacing:0.05em; flex-shrink:0; }
      .breaking-title { font-size:0.85rem; font-weight:500; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .breaking-arrow { flex-shrink:0; font-size:0.75rem; color:var(--text-muted); }

      /* ===== HERO FEATURED ===== */
      .featured {
        display: grid; grid-template-columns: 1.4fr 1fr; gap: 1rem;
        margin-bottom: 2.5rem;
        animation: slideUp 0.5s ease both;
        animation-delay: 0.1s;
      }
      .featured-main {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        text-decoration: none; color: inherit;
        transition: all 0.3s;
        display: flex; flex-direction: column;
      }
      .featured-main:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 20px rgba(0,229,255,0.04);
      }
      .featured-main-top {
        padding: 1.5rem 1.5rem 1rem;
        flex: 1;
      }
      .featured-tag {
        display: inline-block;
        font-family:'SF Mono',monospace; font-size:0.62rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        background: rgba(0,229,255,0.08);
        color: var(--neon-cyan);
        letter-spacing: 0.05em;
        margin-bottom: 0.6rem;
      }
      .featured-main h2 {
        font-size: 1.15rem; font-weight: 700;
        margin-bottom: 0.4rem;
        line-height: 1.3;
      }
      .featured-main p {
        font-size: 0.82rem; color: var(--text-secondary);
        margin: 0 0 0.8rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .featured-main-footer {
        padding: 0.7rem 1.5rem;
        border-top: 1px solid var(--border);
        display: flex; justify-content: space-between;
        font-size: 0.72rem; font-family:'SF Mono',monospace;
        color: var(--text-muted);
      }
      .featured-side {
        display: flex; flex-direction: column; gap: 0.75rem;
      }
      .featured-side-item {
        display: flex; gap: 0.75rem;
        padding: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        flex: 1;
      }
      .featured-side-item:hover {
        border-color: var(--neon-cyan);
      }
      .featured-side-icon { font-size: 1rem; margin-top: 0.1rem; }
      .featured-side-body { flex: 1; min-width: 0; }
      .featured-side-body h3 { font-size: 0.82rem; font-weight: 600; margin-bottom: 0.1rem; }
      .featured-side-body p { font-size: 0.72rem; color: var(--text-muted); margin: 0; }
      .featured-side-meta { font-size: 0.62rem; font-family:'SF Mono',monospace; color: var(--text-muted); }

      /* ===== SECTION HEADERS ===== */
      .section-hd {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 1rem;
        animation: slideUp 0.4s ease both;
        animation-delay: 0.2s;
      }
      .section-hd-left { display: flex; align-items: center; gap: 0.6rem; }
      .section-hd-acc {
        font-family:'SF Mono',monospace; font-size:0.65rem;
        color: var(--neon-cyan); letter-spacing:0.08em;
        padding: 0.15rem 0.4rem;
        border: 1px solid rgba(0,229,255,0.15);
        border-radius: 4px;
      }
      .section-hd h2 { font-size: 1.15rem; font-weight: 700; }
      .section-hd a { font-size: 0.78rem; color: var(--text-muted); font-family:'SF Mono',monospace; }
      .section-hd a:hover { color: var(--neon-cyan); }

      /* ===== UAP GRID ===== */
      .uap-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;
        margin-bottom: 2.5rem;
      }
      .uap-card {
        padding: 1rem 1.2rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-decoration: none; color: inherit;
        transition: all 0.25s;
        animation: slideUp 0.4s ease both;
      }
      .uap-card:nth-child(1) { animation-delay: 0.05s; }
      .uap-card:nth-child(2) { animation-delay: 0.1s; }
      .uap-card:nth-child(3) { animation-delay: 0.15s; }
      .uap-card:nth-child(4) { animation-delay: 0.2s; }
      .uap-card:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 15px rgba(0,229,255,0.03);
        transform: translateY(-1px);
      }
      .uap-card-meta {
        font-family:'SF Mono',monospace; font-size:0.62rem;
        color: var(--text-muted); margin-bottom: 0.25rem;
        display: flex; gap: 0.4rem;
      }
      .uap-card-meta .uap-tag { color: var(--neon-cyan); font-weight: 600; }
      .uap-card h3 { font-size: 0.88rem; font-weight: 600; margin-bottom: 0.2rem; }
      .uap-card p { font-size: 0.76rem; color: var(--text-secondary); margin: 0;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

      /* ===== FEED ===== */
      .feed { margin-bottom: 2.5rem; }
      .feed-item {
        display: flex; gap: 0.85rem; padding: 0.8rem 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: fadeIn 0.5s ease both;
      }
      .feed-item:last-child { border-bottom: none; }
      .feed-item:hover { opacity: 0.85; }
      .feed-item:hover h3 { color: var(--neon-cyan); }
      .feed-icon {
        flex-shrink: 0; width: 28px; height: 28px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(0,229,255,0.04);
        border: 1px solid var(--border);
        border-radius: 50%;
        font-size: 0.75rem;
      }
      .feed-body { flex: 1; min-width: 0; }
      .feed-meta { font-family:'SF Mono',monospace; font-size:0.65rem; color:var(--text-muted); margin-bottom:0.05rem; }
      .feed-body h3 { font-size:0.85rem; font-weight:600; margin:0; transition:color 0.2s; }
      .feed-body p { font-size:0.76rem; color:var(--text-secondary); margin:0.1rem 0 0; }
      .feed-time { flex-shrink:0; font-size:0.62rem; font-family:'SF Mono',monospace; color:var(--text-muted); }

      /* ===== DOMAINS ===== */
      .domains {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .domain-item {
        padding: 1rem 0.75rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-align: center;
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: slideUp 0.4s ease both;
      }
      .domain-item:nth-child(2) { animation-delay: 0.05s; }
      .domain-item:nth-child(3) { animation-delay: 0.1s; }
      .domain-item:nth-child(4) { animation-delay: 0.15s; }
      .domain-item:hover { border-color: var(--neon-cyan); background: rgba(0,229,255,0.02); }
      .domain-icon { font-size: 1.2rem; margin-bottom: 0.25rem; }
      .domain-label { font-size: 0.72rem; font-weight: 500; }
      .domain-count { font-size: 0.62rem; font-family:'SF Mono',monospace; color: var(--neon-cyan); margin-top: 0.15rem; }

      /* ===== RESPONSIVE ===== */
      @media(max-width: 700px) {
        .featured { grid-template-columns: 1fr; gap: 0.75rem; }
        .featured-main h2 { font-size: 1rem; }
        .featured-main p { -webkit-line-clamp: 2; }
        .uap-grid { grid-template-columns: 1fr; }
        .domains { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
        .breaking { padding: 0.5rem 0.75rem; margin-top: 0.5rem; }
        .breaking-title { font-size: 0.78rem; white-space: normal; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
        .section-hd h2 { font-size: 1rem; }
      }
      @media(max-width: 480px)
      /* ===== DISCLOSER HERO ===== */
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700;900&display=swap');

      .discloser-hero {
        position: relative; width: 100%; background: #050505;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 60px 20px 40px;
        font-family: 'Cormorant Garamond', 'Georgia', serif;
        overflow: hidden;
      }
      .discloser-hero .hero-circle {
        position: relative; width: 360px; height: 360px; max-width: 80vw; max-height: 80vw;
      }
      .discloser-hero .film-circle {
        position: relative; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;
        border: 10px solid #ffffff;
        box-shadow: 0 0 0 2px rgba(255,255,255,0.15) inset, 0 0 0 4px rgba(255,255,255,0.08) inset,
          0 0 0 8px rgba(0,0,0,1) inset, 0 0 0 10px rgba(255,255,255,0.25) inset,
          0 0 30px rgba(0,0,0,0.6) inset;
      }
      .discloser-hero .film-circle-inner {
        position: absolute; inset: 0; border-radius: 50%; background: #020202; overflow: hidden;
      }
      .discloser-hero .stars-container { position: absolute; inset: 0; }
      .discloser-hero .star {
        position: absolute; background: #ffffff; border-radius: 50%;
        animation: dTwinkle var(--speed) ease-in-out infinite alternate;
        animation-delay: var(--delay);
      }
      @keyframes dTwinkle { 0% { opacity: 0.1; } 100% { opacity: var(--max-opacity); } }
      
      .discloser-hero .planet-container {
        position: absolute; top: 22%; left: 18%; width: 35%; height: 35%;
        animation: dFloat 6s ease-in-out infinite;
      }
      @keyframes dFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
      .discloser-hero .planet { width:100%; height:100%; border-radius:50%; background:#ffffff; position:relative; }
      .discloser-hero .planet-band { position:absolute; left:5%; width:90%; height:10%; background:rgba(0,0,0,0.08); border-radius:50%; }
      .discloser-hero .planet-band-1 { top:38%; }
      .discloser-hero .planet-band-2 { top:56%; }
      .discloser-hero .ring-back, .discloser-hero .ring-front {
        position:absolute; top:42%; left:-15%; width:130%; height:16%;
        border:3px solid #ffffff; border-radius:50%; transform:rotate(-22deg);
      }
      .discloser-hero .ring-back { clip-path:inset(0 0 50% 0); opacity:0.45; border-width:4px; }
      .discloser-hero .ring-front { clip-path:inset(50% 0 0 0); opacity:0.55; border-width:4px; }
      
      .discloser-hero .ship-container {
        position:absolute; top:42%; right:30%; width:30%; height:30%;
        animation:dFly 8s ease-in-out infinite;
      }
      @keyframes dFly { 0%,100%{transform:translate(0,0) rotate(42deg)} 50%{transform:translate(-8px,4px) rotate(42deg)} }
      .discloser-hero .ship { position:relative; width:100%; height:100%; }
      .discloser-hero .ship-flame {
        position:absolute; bottom:2%; left:50%; transform:translateX(-50%);
        width:20%; height:25%; background:#ffffff; border-radius:50%; opacity:0.4;
        animation:dFlame 0.4s ease-in-out infinite alternate;
      }
      .discloser-hero .ship-flame-inner {
        position:absolute; bottom:0%; left:50%; transform:translateX(-50%);
        width:12%; height:20%; background:#ffffff; border-radius:50%; opacity:0.7;
        animation:dFlame 0.3s ease-in-out infinite alternate-reverse;
      }
      @keyframes dFlame { 0%{transform:translateX(-50%) scaleY(0.8);opacity:0.3} 100%{transform:translateX(-50%) scaleY(1.1);opacity:0.5} }
      .discloser-hero .ship-body { position:absolute; top:10%; left:42%; width:16%; height:60%; background:#ffffff; border-radius:2px; }
      .discloser-hero .ship-pod { position:absolute; top:0%; left:30%; width:40%; height:25%; background:#ffffff; clip-path:polygon(20% 0%,80% 0%,100% 100%,0% 100%); border-radius:4px 4px 0 0; }
      .discloser-hero .ship-pod-window { position:absolute; top:8%; left:50%; transform:translateX(-50%); width:40%; height:40%; background:#000000; border-radius:50%; }
      .discloser-hero .ship-cargo { position:absolute; top:40%; left:30%; width:40%; height:25%; background:#ffffff; border:1px solid #000000; }
      .discloser-hero .ship-arm-l, .discloser-hero .ship-arm-r { position:absolute; top:18%; width:6%; height:50%; background:#ffffff; }
      .discloser-hero .ship-arm-l { left:30%; }
      .discloser-hero .ship-arm-r { right:30%; }
      .discloser-hero .ship-panel-l, .discloser-hero .ship-panel-r { position:absolute; top:14%; width:20%; height:18%; background:#ffffff; border-radius:2px; }
      .discloser-hero .ship-panel-l { left:0%; }
      .discloser-hero .ship-panel-r { right:0%; }
      .discloser-hero .ship-ring { position:absolute; top:16%; left:16%; width:68%; height:55%; border:3px solid #ffffff; border-radius:50%; }
      .discloser-hero .ship-ring-inner { position:absolute; top:22%; left:22%; width:56%; height:45%; border:2px solid #ffffff; border-radius:50%; }
      .discloser-hero .ship-spoke-v { position:absolute; top:0%; left:50%; transform:translateX(-50%); width:2px; height:80%; background:#ffffff; }
      .discloser-hero .ship-spoke-h { position:absolute; top:35%; left:10%; width:80%; height:2px; background:#ffffff; }
      .discloser-hero .ship-leg-l, .discloser-hero .ship-leg-r { position:absolute; bottom:2%; width:3px; height:12%; background:#ffffff; }
      .discloser-hero .ship-leg-l { left:35%; transform:rotate(15deg); }
      .discloser-hero .ship-leg-r { right:35%; transform:rotate(-15deg); }
      
      .discloser-hero .grain-overlay {
        position:absolute; inset:0; border-radius:50%; opacity:0.04; pointer-events:none;
        background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-size:128px 128px;
      }
      .discloser-hero .vignette { position:absolute; inset:-5%; border-radius:50%; pointer-events:none; background:radial-gradient(ellipse at center, transparent 45%, rgba(0,0,0,0.5) 100%); }
      
      .discloser-hero .text-area { text-align:center; margin-top:24px; width:100%; }
      .discloser-hero .chinese-line { display:flex; align-items:center; justify-content:center; }
      .discloser-hero .char-left, .discloser-hero .char-right {
        font-size:56px; font-weight:900; color:#ffffff;
        display:inline-block; letter-spacing:24px; opacity:0;
        -webkit-animation:initIn 0.9s cubic-bezier(0.16,1,0.3,1) forwards;
        animation:initIn 0.9s cubic-bezier(0.16,1,0.3,1) forwards;
      }
      .discloser-hero .char-left {
        -webkit-animation-name:flyL; animation-name:flyL;
        -webkit-animation-delay:0.6s; animation-delay:0.6s;
      }
      .discloser-hero .char-right {
        -webkit-animation-name:flyR; animation-name:flyR;
        -webkit-animation-delay:0.6s; animation-delay:0.6s;
      }
      @-webkit-keyframes flyL { 0%{opacity:0;-webkit-transform:translateX(-100px);transform:translateX(-100px)} 100%{opacity:1;-webkit-transform:translateX(0);transform:translateX(0)} }
      @keyframes flyL { 0%{opacity:0;transform:translateX(-100px)} 100%{opacity:1;transform:translateX(0)} }
      @-webkit-keyframes flyR { 0%{opacity:0;-webkit-transform:translateX(100px);transform:translateX(100px)} 100%{opacity:1;-webkit-transform:translateX(0);transform:translateX(0)} }
      @keyframes flyR { 0%{opacity:0;transform:translateX(100px)} 100%{opacity:1;transform:translateX(0)} }
      
      .discloser-hero .separator {
        display:block; height:2px; background:rgba(255,255,255,0.6);
        margin:8px auto 0; width:0;
        -webkit-animation:sepGrow 0.7s ease-out forwards; animation:sepGrow 0.7s ease-out forwards;
        -webkit-animation-delay:1.4s; animation-delay:1.4s;
      }
      @-webkit-keyframes sepGrow { 0%{width:0} 100%{width:180px} }
      @keyframes sepGrow { 0%{width:0} 100%{width:180px} }
      
      .discloser-hero .english {
        font-size:20px; font-weight:700; color:rgba(255,255,255,0.7);
        letter-spacing:14px; margin-top:10px; opacity:0;
        -webkit-animation:engUp 0.7s ease-out forwards; animation:engUp 0.7s ease-out forwards;
        -webkit-animation-delay:1.6s; animation-delay:1.6s;
      }
      @-webkit-keyframes engUp { 0%{opacity:0;-webkit-transform:translateY(20px);transform:translateY(20px)} 100%{opacity:1;-webkit-transform:translateY(0);transform:translateY(0)} }
      @keyframes engUp { 0%{opacity:0;transform:translateY(20px)} 100%{opacity:1;transform:translateY(0)} }
      
      .discloser-hero .scroll-hint {
        margin-top:28px; color:rgba(255,255,255,0.15);
        font-size:11px; letter-spacing:4px;
        animation:dScroll 2s ease-in-out infinite;
      }
      @keyframes dScroll { 0%,100%{transform:translateY(0);opacity:0.15} 50%{transform:translateY(6px);opacity:0.35} }

      @media(max-width:700px) {
        .discloser-hero { padding:40px 16px 24px; }
        .discloser-hero .hero-circle { width:280px; height:280px; }
        .discloser-hero .char-left, .discloser-hero .char-right { font-size:40px; letter-spacing:16px; }
        .discloser-hero .english { font-size:15px; letter-spacing:10px; }
      }
      @media(max-width:480px) {
        .discloser-hero .hero-circle { width:220px; height:220px; }
        .discloser-hero .char-left, .discloser-hero .char-right { font-size:32px; letter-spacing:12px; }
        .discloser-hero .english { font-size:13px; letter-spacing:8px; }
      } {
        .home-wrap { padding: 0 0.65rem; }
        .featured-main-top { padding: 0.85rem; }
        .featured-main-footer { padding: 0.5rem 0.85rem; font-size: 0.65rem; }
        .uap-card { padding: 0.8rem; }
        .domain-item { padding: 0.7rem 0.5rem; }
        .domain-icon { font-size: 1rem; }
        .feed-item { padding: 0.6rem 0; }
      }
    </style>
  </head>
  <body>
    <!-- ===== DISCLOSER HERO SECTION ===== -->
    <section class="discloser-hero">
      <div class="hero-circle">
        <div class="film-circle">
          <div class="film-circle-inner">
            <div class="stars-container" id="discloserStars">
              <script>
                const dc = document.getElementById('discloserStars');
                if (dc) { for (let i = 0; i < 100; i++) {
                    const s = document.createElement('div');
                    s.className = 'star';
                    const sz = Math.random() * 2.5 + 0.5;
                    s.style.width = sz+'px'; s.style.height = sz+'px';
                    s.style.left = Math.random()*100+'%'; s.style.top = Math.random()*100+'%';
                    s.style.setProperty('--speed', (Math.random()*3+1.5)+'s');
                    s.style.setProperty('--delay', (Math.random()*3)+'s');
                    s.style.setProperty('--max-opacity', (Math.random()*0.7+0.3));
                    dc.appendChild(s);
                }}
              </script>
            </div>
            <div class="planet-container">
              <div class="planet">
                <div class="planet-band planet-band-1"></div>
                <div class="planet-band planet-band-2"></div>
                <div class="ring-back"></div><div class="ring-front"></div>
              </div>
            </div>
            <div class="ship-container">
              <div class="ship">
                <div class="ship-flame"></div><div class="ship-flame-inner"></div>
                <div class="ship-body"></div>
                <div class="ship-pod"><div class="ship-pod-window"></div></div>
                <div class="ship-cargo"></div>
                <div class="ship-arm-l"></div><div class="ship-arm-r"></div>
                <div class="ship-panel-l"></div><div class="ship-panel-r"></div>
                <div class="ship-ring"></div><div class="ship-ring-inner"></div>
                <div class="ship-spoke-v"></div><div class="ship-spoke-h"></div>
                <div class="ship-leg-l"></div><div class="ship-leg-r"></div>
              </div>
            </div>
            <div class="grain-overlay"></div>
            <div class="vignette"></div>
          </div>
        </div>
      </div>
      <div class="text-area">
        <div class="chinese-line">
          <span class="char-left">披</span>
          <span class="char-right">露</span>
        </div>
        <span class="separator"></span>
        <div class="english">D I S C L O S E R</div>
      </div>
      <div class="scroll-hint">▼ SCROLL ▼</div>
    </section>
    <Header />
    <main>
      <div class="home-wrap">
        <!-- ===== BREAKING ===== -->
        {latestUAP && (
          <a href={`/vincent-kan-site/blog/${latestUAP.id}/`} class="breaking">
            <span class="breaking-dot"></span>
            <span class="breaking-label">突發</span>
            <span class="breaking-title">{latestUAP.data.title}</span>
            <span class="breaking-arrow">→</span>
          </a>
        )}

        <!-- ===== FEATURED ===== -->
        <div class="featured">
          {latestUAP ? (
            <a href={`/vincent-kan-site/blog/${latestUAP.id}/`} class="featured-main">
              <div class="featured-main-top">
                <span class="featured-tag">🛸 UFO/UAP</span>
                <h2>{latestUAP.data.title}</h2>
                <p>{latestUAP.data.description}</p>
              </div>
              <div class="featured-main-footer">
                <span><FormattedDate date={latestUAP.data.pubDate} /></span>
                <span>閱讀全文 →</span>
              </div>
            </a>
          ) : (
            <div class="featured-main">
              <div class="featured-main-top">
                <span class="featured-tag">🛸 UFO/UAP</span>
                <h2>全球UFO/UAP新聞摘要</h2>
                <p>AI自動搜集每日全球UFO重點新聞，涵蓋政府披露、懸案分析、國際動態。點擊查看最新消息。</p>
              </div>
              <div class="featured-main-footer">
                <span>AI自動更新</span>
              </div>
            </div>
          )}

          <div class="featured-side">
            {uapPosts.slice(1, 3).map(p => (
              <a href={`/vincent-kan-site/blog/${p.id}/`} class="featured-side-item">
                <div class="featured-side-icon">🛸</div>
                <div class="featured-side-body">
                  <h3>{p.data.title}</h3>
                  <p><FormattedDate date={p.data.pubDate} /></p>
                </div>
              </a>
            ))}
            {otherPosts.slice(0, 1).map(p => (
              <a href={`/vincent-kan-site/blog/${p.id}/`} class="featured-side-item">
                <div class="featured-side-icon">📝</div>
                <div class="featured-side-body">
                  <h3>{p.data.title}</h3>
                  <p><FormattedDate date={p.data.pubDate} /></p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- ===== DOMAINS / QUICK LINKS ===== -->
        <div class="domains">
          <a href="/vincent-kan-site/blog" class="domain-item">
            <div class="domain-icon">🛸</div>
            <div class="domain-label">UFO 新聞</div>
            <div class="domain-count">{uapPosts.length} 篇</div>
          </a>
          <a href="/vincent-kan-site/projects" class="domain-item">
            <div class="domain-icon">⚡</div>
            <div class="domain-label">專案</div>
            <div class="domain-count">3 個</div>
          </a>
          <a href="/vincent-kan-site/about" class="domain-item">
            <div class="domain-icon">👤</div>
            <div class="domain-label">關於我</div>
            <div class="domain-count">簡介</div>
          </a>
          <a href="/vincent-kan-site/blog" class="domain-item">
            <div class="domain-icon">📰</div>
            <div class="domain-label">全部文章</div>
            <div class="domain-count">{posts.length} 篇</div>
          </a>
        </div>

        <!-- ===== MORE UFO NEWS ===== -->
        {uapPosts.length > 1 && (
          <>
            <div class="section-hd">
              <div class="section-hd-left">
                <span class="section-hd-acc">/UAP</span>
                <h2>UFO 新聞總覽</h2>
              </div>
              <a href="/vincent-kan-site/blog">查看全部 →</a>
            </div>
            <div class="uap-grid">
              {uapPosts.slice(1, 5).map(p => (
                <a href={`/vincent-kan-site/blog/${p.id}/`} class="uap-card">
                  <div class="uap-card-meta">
                    <span class="uap-tag">🛸 UFO/UAP</span>
                    <span><FormattedDate date={p.data.pubDate} /></span>
                  </div>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </a>
              ))}
            </div>
          </>
        )}

        <!-- ===== OTHER POSTS ===== -->
        {otherPosts.length > 0 && (
          <>
            <div class="section-hd">
              <div class="section-hd-left">
                <span class="section-hd-acc">/BLOG</span>
                <h2>最新文章</h2>
              </div>
              <a href="/vincent-kan-site/blog">全部 →</a>
            </div>
            <div class="feed">
              {otherPosts.slice(0, 4).map(p => (
                <a href={`/vincent-kan-site/blog/${p.id}/`} class="feed-item">
                  <div class="feed-icon">📝</div>
                  <div class="feed-body">
                    <div class="feed-meta"><FormattedDate date={p.data.pubDate} /></div>
                    <h3>{p.data.title}</h3>
                    <p>{p.data.description}</p>
                  </div>
                  <div class="feed-time"><FormattedDate date={p.data.pubDate} /></div>
                </a>
              ))}
            </div>
          </>
        )}

        <!-- ===== FOOTER CTA ===== -->
        <div style="text-align:center;padding:2.5rem 0 3rem;border-top:1px solid var(--border)">
          <p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem">有興趣交流 UFO 話題或者 AI 技術？隨時搵我</p>
          <a href="/vincent-kan-site/about" class="btn btn-primary">關於我</a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>