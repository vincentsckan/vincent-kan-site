---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const uapPosts = posts.filter(p => p.id.startsWith('ufo-')).slice(0, 6);
const otherPosts = posts.filter(p => !p.id.startsWith('ufo-')).slice(0, 4);
const latestUAP = uapPosts[0];
const featuredUAP = uapPosts.slice(1, 4);
---

<!DOCTYPE html>
<html lang="zh-HK">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:inline>
@keyframes fadeIn { 0%{opacity:0} 100%{opacity:1} }
@keyframes slideUp { 0%{transform:translateY(15px);opacity:0} 100%{transform:translateY(0);opacity:1} }
@keyframes pulseDot { 0%,100%{opacity:1} 50%{opacity:0.3} }
@keyframes radarRing { 0%{transform:scale(.5);opacity:.6} 100%{transform:scale(2.5);opacity:0} }
@keyframes glowPulse { 0%,100%{box-shadow:0 0 8px rgba(0,229,255,0.2)} 50%{box-shadow:0 0 25px rgba(0,229,255,0.4)} }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700;900&display=swap">
    <style>
      /* ===== LAYOUT ===== */
      .home-wrap { max-width: 860px; margin: 0 auto; padding: 0 1.5rem; }
      
      /* ===== BREAKING BANNER ===== */
      .breaking {
        display: flex; gap: 0.75rem; align-items: center;
        padding: 0.7rem 1rem;
        border: 1px solid rgba(239,68,68,0.15);
        border-radius: var(--radius-sm);
        background: rgba(239,68,68,0.04);
        margin-bottom: 1.5rem; margin-top: 1rem;
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: slideUp 0.6s ease both;
      }
      .breaking:hover { border-color: rgba(239,68,68,0.3); }
      .breaking-dot { width: 8px; height: 8px; background: #ef4444; border-radius: 50%; flex-shrink: 0; animation: pulseDot 1.5s infinite; }
      .breaking-label { font-family:'SF Mono',monospace; font-size:0.68rem; color:#ef4444; font-weight:600; letter-spacing:0.05em; flex-shrink:0; }
      .breaking-title { font-size:0.85rem; font-weight:500; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .breaking-arrow { flex-shrink:0; font-size:0.75rem; color:var(--text-muted); }

      /* ===== HERO FEATURED ===== */
      .featured {
        display: grid; grid-template-columns: 1.4fr 1fr; gap: 1rem;
        margin-bottom: 2.5rem;
        animation: slideUp 0.5s ease both;
        animation-delay: 0.1s;
      }
      .featured-main {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        text-decoration: none; color: inherit;
        transition: all 0.3s;
        display: flex; flex-direction: column;
      }
      .featured-main:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 20px rgba(0,229,255,0.04);
      }
      .featured-main-top {
        padding: 1.5rem 1.5rem 1rem;
        flex: 1;
      }
      .featured-tag {
        display: inline-block;
        font-family:'SF Mono',monospace; font-size:0.62rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        background: rgba(0,229,255,0.08);
        color: var(--neon-cyan);
        letter-spacing: 0.05em;
        margin-bottom: 0.6rem;
      }
      .featured-main h2 {
        font-size: 1.15rem; font-weight: 700;
        margin-bottom: 0.4rem;
        line-height: 1.3;
      }
      .featured-main p {
        font-size: 0.82rem; color: var(--text-secondary);
        margin: 0 0 0.8rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .featured-main-footer {
        padding: 0.7rem 1.5rem;
        border-top: 1px solid var(--border);
        display: flex; justify-content: space-between;
        font-size: 0.72rem; font-family:'SF Mono',monospace;
        color: var(--text-muted);
      }
      .featured-side {
        display: flex; flex-direction: column; gap: 0.75rem;
      }
      .featured-side-item {
        display: flex; gap: 0.75rem;
        padding: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        flex: 1;
      }
      .featured-side-item:hover {
        border-color: var(--neon-cyan);
      }
      .featured-side-icon { font-size: 1rem; margin-top: 0.1rem; }
      .featured-side-body { flex: 1; min-width: 0; }
      .featured-side-body h3 { font-size: 0.82rem; font-weight: 600; margin-bottom: 0.1rem; }
      .featured-side-body p { font-size: 0.72rem; color: var(--text-muted); margin: 0; }
      .featured-side-meta { font-size: 0.62rem; font-family:'SF Mono',monospace; color: var(--text-muted); }

      /* ===== SECTION HEADERS ===== */
      .section-hd {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 1rem;
        animation: slideUp 0.4s ease both;
        animation-delay: 0.2s;
      }
      .section-hd-left { display: flex; align-items: center; gap: 0.6rem; }
      .section-hd-acc {
        font-family:'SF Mono',monospace; font-size:0.65rem;
        color: var(--neon-cyan); letter-spacing:0.08em;
        padding: 0.15rem 0.4rem;
        border: 1px solid rgba(0,229,255,0.15);
        border-radius: 4px;
      }
      .section-hd h2 { font-size: 1.15rem; font-weight: 700; }
      .section-hd a { font-size: 0.78rem; color: var(--text-muted); font-family:'SF Mono',monospace; }
      .section-hd a:hover { color: var(--neon-cyan); }

      /* ===== UAP GRID ===== */
      .uap-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;
        margin-bottom: 2.5rem;
      }
      .uap-card {
        padding: 1rem 1.2rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-decoration: none; color: inherit;
        transition: all 0.25s;
        animation: slideUp 0.4s ease both;
      }
      .uap-card:nth-child(1) { animation-delay: 0.05s; }
      .uap-card:nth-child(2) { animation-delay: 0.1s; }
      .uap-card:nth-child(3) { animation-delay: 0.15s; }
      .uap-card:nth-child(4) { animation-delay: 0.2s; }
      .uap-card:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 15px rgba(0,229,255,0.03);
        transform: translateY(-1px);
      }
      .uap-card-meta {
        font-family:'SF Mono',monospace; font-size:0.62rem;
        color: var(--text-muted); margin-bottom: 0.25rem;
        display: flex; gap: 0.4rem;
      }
      .uap-card-meta .uap-tag { color: var(--neon-cyan); font-weight: 600; }
      .uap-card h3 { font-size: 0.88rem; font-weight: 600; margin-bottom: 0.2rem; }
      .uap-card p { font-size: 0.76rem; color: var(--text-secondary); margin: 0;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

      /* ===== FEED ===== */
      .feed { margin-bottom: 2.5rem; }
      .feed-item {
        display: flex; gap: 0.85rem; padding: 0.8rem 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: fadeIn 0.5s ease both;
      }
      .feed-item:last-child { border-bottom: none; }
      .feed-item:hover { opacity: 0.85; }
      .feed-item:hover h3 { color: var(--neon-cyan); }
      .feed-icon {
        flex-shrink: 0; width: 28px; height: 28px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(0,229,255,0.04);
        border: 1px solid var(--border);
        border-radius: 50%;
        font-size: 0.75rem;
      }
      .feed-body { flex: 1; min-width: 0; }
      .feed-meta { font-family:'SF Mono',monospace; font-size:0.65rem; color:var(--text-muted); margin-bottom:0.05rem; }
      .feed-body h3 { font-size:0.85rem; font-weight:600; margin:0; transition:color 0.2s; }
      .feed-body p { font-size:0.76rem; color:var(--text-secondary); margin:0.1rem 0 0; }
      .feed-time { flex-shrink:0; font-size:0.62rem; font-family:'SF Mono',monospace; color:var(--text-muted); }

      /* ===== DOMAINS ===== */
      .domains {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .domain-item {
        padding: 1rem 0.75rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-align: center;
        text-decoration: none; color: inherit;
        transition: all 0.2s;
        animation: slideUp 0.4s ease both;
      }
      .domain-item:nth-child(2) { animation-delay: 0.05s; }
      .domain-item:nth-child(3) { animation-delay: 0.1s; }
      .domain-item:nth-child(4) { animation-delay: 0.15s; }
      .domain-item:hover { border-color: var(--neon-cyan); background: rgba(0,229,255,0.02); }
      .domain-icon { font-size: 1.2rem; margin-bottom: 0.25rem; }
      .domain-label { font-size: 0.72rem; font-weight: 500; }
      .domain-count { font-size: 0.62rem; font-family:'SF Mono',monospace; color: var(--neon-cyan); margin-top: 0.15rem; }

      /* ===== RESPONSIVE ===== */
      
      /* ===== DISCLOSER HERO ===== */
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700;900&display=swap');
      
      .discloser-hero-wrap {
        width: 100%; background: #050505;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 30px 20px 15px;
        font-family: 'Cormorant Garamond', 'Georgia', serif;
        position: sticky; top: 0; z-index: 1;
        min-height: 33vh; min-height: 33dvh;
        overflow: hidden;
      }
      .discloser-hero-wrap + * { position: relative; z-index: 2; background: var(--bg); }
      
      /* Stars */
      .ds-star { position:absolute; background:#ffffff; border-radius:50%; animation:dsTw var(--speed) ease-in-out infinite alternate; animation-delay:var(--delay); }
      @keyframes dsTw { 0%{opacity:0.1} 100%{opacity:var(--max-opacity)} }
      
      /* Planet */
      .ds-planet-c { position:absolute; top:15%; left:18%; width:28%; height:28%; }
      .ds-planet { width:100%; height:100%; border-radius:50%; background:#ffffff; position:relative; }
      .ds-planet-b { position:absolute; left:6%; width:88%; height:8%; background:rgba(0,0,0,0.1); border-radius:50%; }
      .ds-planet-b1 { top:42%; } .ds-planet-b2 { top:54%; }
      .ds-ring { position:absolute; top:44%; left:-12%; width:124%; height:14%; border:3px solid #ffffff; border-radius:50%; }
      .ds-ring-back { clip-path:inset(0 0 50% 0); opacity:0.4; transform:rotate(-20deg); }
      .ds-ring-front { clip-path:inset(50% 0 0 0); opacity:0.5; transform:rotate(-20deg); }
      
      /* Ship - Endurance style */
      .ds-ship-c { position:absolute; top:38%; right:25%; width:28%; height:28%; animation:dsFly 8s ease-in-out infinite; }
      @keyframes dsFly { 0%,100%{transform:translate(0,0) rotate(38deg)} 50%{transform:translate(-6px,3px) rotate(38deg)} }
      
      .ds-ship { position:relative; width:100%; height:100%; }
      .ds-flame { position:absolute; bottom:-2%; left:50%; transform:translateX(-50%); width:20%; height:28%; background:#ffffff; border-radius:50%; opacity:0.3; animation:dsFl 0.4s ease-in-out infinite alternate; }
      .ds-flame-i { position:absolute; bottom:-4%; left:50%; transform:translateX(-50%); width:12%; height:24%; background:#ffffff; border-radius:50%; opacity:0.55; animation:dsFl 0.3s ease-in-out infinite alternate-reverse; }
      @keyframes dsFl { 0%{transform:translateX(-50%) scaleY(0.8);opacity:0.25} 100%{transform:translateX(-50%) scaleY(1.15);opacity:0.45} }
      .ds-trail { position:absolute; bottom:-18%; left:50%; transform:translateX(-50%); width:3px; height:25%; background:linear-gradient(to bottom, rgba(255,255,255,0.35), transparent); animation:dsTr 1.5s linear infinite; }
      @keyframes dsTr { 0%{height:5%;opacity:0.3} 100%{height:35%;opacity:0} }
      
      .ds-sbody { position:absolute; top:14%; left:42%; width:16%; height:50%; background:#ffffff; border-radius:1px; }
      .ds-spod { position:absolute; top:3%; left:30%; width:40%; height:18%; background:#ffffff; clip-path:polygon(20% 0%,80% 0%,100% 100%,0% 100%); border-radius:3px 3px 0 0; }
      .ds-spod-w { position:absolute; top:7%; left:50%; transform:translateX(-50%); width:34%; height:40%; background:#000; border-radius:50%; }
      .ds-scargo { position:absolute; top:38%; left:30%; width:40%; height:18%; background:#ffffff; border:1px solid #000; }
      .ds-sarm-l, .ds-sarm-r { position:absolute; top:18%; width:4%; height:38%; background:#ffffff; }
      .ds-sarm-l { left:32%; } .ds-sarm-r { right:32%; }
      .ds-spanel-l, .ds-spanel-r { position:absolute; top:15%; background:#ffffff; border-radius:1px; }
      .ds-spanel-l { left:0%; width:22%; height:16%; } .ds-spanel-r { right:0%; width:22%; height:16%; }
      .ds-sring-o { position:absolute; top:15%; left:15%; width:70%; height:46%; border:3px solid #ffffff; border-radius:50%; }
      .ds-sring-i { position:absolute; top:21%; left:21%; width:58%; height:38%; border:2px solid #ffffff; border-radius:50%; }
      .ds-spoke-v { position:absolute; top:0%; left:50%; transform:translateX(-50%); width:2px; height:76%; background:#ffffff; }
      .ds-spoke-h { position:absolute; top:36%; left:10%; width:80%; height:2px; background:#ffffff; }
      .ds-sdock { position:absolute; top:-4%; left:50%; transform:translateX(-50%); width:10%; height:6%; background:#ffffff; }
      .ds-sleg-l, .ds-sleg-r { position:absolute; bottom:6%; width:2px; height:16%; background:#ffffff; }
      .ds-sleg-l { left:36%; transform:rotate(16deg); } .ds-sleg-r { right:36%; transform:rotate(-16deg); }
      
      /* Grain + vignette */
      .ds-grain { position:absolute; inset:0; border-radius:50%; opacity:0.03; pointer-events:none; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); background-size:100px 100px; }
      .ds-vignette { position:absolute; inset:-5%; border-radius:50%; pointer-events:none; background:radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.55) 100%); }
      
      /* Text animations */
      .ds-text { text-align:center; margin-top:8px; width:100%; }
      .ds-cline { display:flex; align-items:center; justify-content:center; }
      .ds-cl, .ds-cr { font-size:36px; font-weight:900; color:#fff; display:inline-block; letter-spacing:12px; opacity:0; -webkit-animation:dsIn 0.8s cubic-bezier(0.16,1,0.3,1) forwards; animation:dsIn 0.8s cubic-bezier(0.16,1,0.3,1) forwards; }
      .ds-cl { -webkit-animation-name:dsL; animation-name:dsL; -webkit-animation-delay:0.4s; animation-delay:0.4s; }
      .ds-cr { -webkit-animation-name:dsR; animation-name:dsR; -webkit-animation-delay:0.4s; animation-delay:0.4s; }
      @-webkit-keyframes dsL { 0%{opacity:0;-webkit-transform:translateX(-60px);transform:translateX(-60px)} 100%{opacity:1;-webkit-transform:translateX(0);transform:translateX(0)} }
      @keyframes dsL { 0%{opacity:0;transform:translateX(-60px)} 100%{opacity:1;transform:translateX(0)} }
      @-webkit-keyframes dsR { 0%{opacity:0;-webkit-transform:translateX(60px);transform:translateX(60px)} 100%{opacity:1;-webkit-transform:translateX(0);transform:translateX(0)} }
      @keyframes dsR { 0%{opacity:0;transform:translateX(60px)} 100%{opacity:1;transform:translateX(0)} }
      .ds-sep { display:block; height:1.5px; background:rgba(255,255,255,0.6); margin:3px auto 0; width:0; -webkit-animation:dsG 0.6s ease-out forwards; animation:dsG 0.6s ease-out forwards; -webkit-animation-delay:1s; animation-delay:1s; }
      @-webkit-keyframes dsG { 0%{width:0} 100%{width:100px} }
      @keyframes dsG { 0%{width:0} 100%{width:100px} }
      .ds-en { font-size:13px; font-weight:700; color:rgba(255,255,255,0.7); letter-spacing:9px; margin-top:4px; opacity:0; -webkit-animation:dsU 0.6s ease-out forwards; animation:dsU 0.6s ease-out forwards; -webkit-animation-delay:1.2s; animation-delay:1.2s; }
      @-webkit-keyframes dsU { 0%{opacity:0;-webkit-transform:translateY(12px);transform:translateY(12px)} 100%{opacity:1;-webkit-transform:translateY(0);transform:translateY(0)} }
      @keyframes dsU { 0%{opacity:0;transform:translateY(12px)} 100%{opacity:1;transform:translateY(0)} }
      
      @media(min-width:701px) {
        .discloser-hero-wrap { min-height: 35vh; padding: 40px 20px; }
        .ds-cl, .ds-cr { font-size: 44px; letter-spacing: 16px; }
        .ds-en { font-size: 16px; letter-spacing: 11px; }
      }
      @media(max-width: 700px) {
        .featured { grid-template-columns: 1fr; gap: 0.75rem; }
        .featured-main h2 { font-size: 1rem; }
        .featured-main p { -webkit-line-clamp: 2; }
        .uap-grid { grid-template-columns: 1fr; }
        .domains { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
        .breaking { padding: 0.5rem 0.75rem; margin-top: 0.5rem; }
        .breaking-title { font-size: 0.78rem; white-space: normal; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
        .section-hd h2 { font-size: 1rem; }
      }
      @media(max-width: 480px) {
        .home-wrap { padding: 0 0.65rem; }
        .featured-main-top { padding: 0.85rem; }
        .featured-main-footer { padding: 0.5rem 0.85rem; font-size: 0.65rem; }
        .uap-card { padding: 0.8rem; }
        .domain-item { padding: 0.7rem 0.5rem; }
        .domain-icon { font-size: 1rem; }
        .feed-item { padding: 0.6rem 0; }
      }
    </style>
  </head>
  <body>

    <Header />
    <main>
<section class="discloser-hero-wrap">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" style="width:280px;height:280px;max-width:55vw;max-height:55vw;display:block;margin:0 auto;">
        <defs>
          <clipPath id="dcCircle"><circle cx="300" cy="300" r="275"/></clipPath>
          <filter id="dcGrain">
            <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="3" result="n" stitchTiles="stitch"/>
            <feColorMatrix type="saturate" values="0" in="n" result="gn"/>
            <feBlend in="SourceGraphic" in2="gn" mode="multiply"/>
            <feComponentTransfer><feFuncR type="linear" slope="1.15" intercept="-0.03"/><feFuncG type="linear" slope="1.15" intercept="-0.03"/><feFuncB type="linear" slope="1.15" intercept="-0.03"/></feComponentTransfer>
          </filter>
        </defs>
        
        <!-- Film frame -->
        <circle cx="300" cy="300" r="290" fill="none" stroke="#ffffff" stroke-width="14"/>
        <circle cx="300" cy="300" r="298" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.25"/>
        <circle cx="300" cy="300" r="280" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.15"/>
        <circle cx="300" cy="300" r="272" fill="none" stroke="#ffffff" stroke-width="3"/>
        
        <g clip-path="url(#dcCircle)" filter="url(#dcGrain)">
          <!-- Space bg -->
          <rect x="0" y="0" width="600" height="600" fill="#020202"/>
          
          <!-- Stars (key ones from SVG) -->
          <circle cx="510" cy="140" r="0.8" fill="white" opacity="0.7"/>
          <circle cx="180" cy="480" r="0.6" fill="white" opacity="0.65"/>
          <circle cx="200" cy="380" r="1.0" fill="white" opacity="0.2"/>
          <circle cx="260" cy="320" r="1.2" fill="white" opacity="0.15"/>
          <circle cx="520" cy="480" r="1.0" fill="white" opacity="0.4"/>
          <circle cx="300" cy="200" r="1.5" fill="white" opacity="0.1"/>
          <circle cx="480" cy="260" r="1.0" fill="white" opacity="0.3"/>
          <circle cx="450" cy="200" r="1.5" fill="white" opacity="0.15"/>
          <circle cx="380" cy="80" r="0.7" fill="white" opacity="0.6"/>
          <circle cx="150" cy="220" r="0.5" fill="white" opacity="0.5"/>
          <circle cx="420" cy="120" r="0.5" fill="white" opacity="0.55"/>
          <circle cx="250" cy="140" r="0.4" fill="white" opacity="0.7"/>
          <circle cx="350" cy="180" r="0.3" fill="white" opacity="0.45"/>
          <circle cx="490" cy="350" r="0.4" fill="white" opacity="0.3"/>
          <circle cx="140" cy="300" r="0.8" fill="white" opacity="0.6"/>
          <circle cx="180" cy="150" r="0.3" fill="white" opacity="0.55"/>
          <circle cx="430" cy="450" r="0.5" fill="white" opacity="0.35"/>
          <circle cx="340" cy="420" r="0.4" fill="white" opacity="0.3"/>
          <circle cx="410" cy="330" r="0.3" fill="white" opacity="0.25"/>
          <circle cx="210" cy="430" r="0.6" fill="white" opacity="0.4"/>
          <circle cx="350" cy="350" r="1.0" fill="white" opacity="0.12"/>
          <circle cx="530" cy="210" r="0.3" fill="white" opacity="0.4"/>
          <circle cx="120" cy="420" r="0.5" fill="white" opacity="0.45"/>
          <circle cx="460" cy="160" r="0.7" fill="white" opacity="0.5"/>
          <circle cx="230" cy="350" r="0.4" fill="white" opacity="0.35"/>
          <circle cx="380" cy="280" r="0.5" fill="white" opacity="0.4"/>
          
          <!-- Planet (top-left quadrant) -->
          <g transform="translate(140, 130)">
            <circle cx="60" cy="60" r="50" fill="#ffffff"/>
            <!-- Bands -->
            <ellipse cx="60" cy="48" rx="45" ry="5" fill="rgba(0,0,0,0.08)"/>
            <ellipse cx="60" cy="58" rx="42" ry="4" fill="rgba(0,0,0,0.06)"/>
            <ellipse cx="60" cy="72" rx="43" ry="4" fill="rgba(0,0,0,0.07)"/>
            <!-- Rings -->
            <ellipse cx="60" cy="60" rx="72" ry="10" fill="none" stroke="#ffffff" stroke-width="3" transform="rotate(-18, 60, 60)" clip-path="inset(0 0 55% 0)" opacity="0.4"/>
            <ellipse cx="60" cy="60" rx="72" ry="10" fill="none" stroke="#ffffff" stroke-width="3" transform="rotate(-18, 60, 60)" clip-path="inset(55% 0 0 0)" opacity="0.5"/>
          </g>
          
          <!-- Ship (top-right quadrant) - Endurance style -->
          <g transform="translate(380, 170) rotate(38)">
            <!-- Trail -->
            <rect x="45" y="52" width="2" height="20" fill="rgba(255,255,255,0.2)" rx="1"/>
            <!-- Flames -->
            <ellipse cx="46" cy="48" rx="8" ry="10" fill="#ffffff" opacity="0.35"/>
            <ellipse cx="46" cy="50" rx="5" ry="8" fill="#ffffff" opacity="0.6"/>
            <!-- Main body -->
            <rect x="42" y="6" width="8" height="24" fill="#ffffff"/>
            <!-- Pod -->
            <polygon points="40,0 52,0 56,10 36,10" fill="#ffffff"/>
            <circle cx="46" cy="5" r="3.5" fill="#000000"/>
            <!-- Cargo -->
            <rect x="38" y="16" width="16" height="8" fill="#ffffff" stroke="#000" stroke-width="0.5"/>
            <line x1="40" y1="18" x2="52" y2="18" stroke="#000" stroke-width="0.3"/>
            <line x1="40" y1="20" x2="52" y2="20" stroke="#000" stroke-width="0.3"/>
            <!-- Arms -->
            <rect x="36" y="8" width="3" height="16" fill="#ffffff"/>
            <rect x="53" y="8" width="3" height="16" fill="#ffffff"/>
            <!-- Solar panels -->
            <rect x="0" y="6" width="12" height="8" fill="#ffffff"/>
            <rect x="80" y="6" width="12" height="8" fill="#ffffff"/>
            <rect x="10" y="14" width="2" height="8" fill="#ffffff"/>
            <rect x="80" y="14" width="2" height="8" fill="#ffffff"/>
            <!-- Outer ring -->
            <circle cx="46" cy="16" r="18" fill="none" stroke="#ffffff" stroke-width="2.5"/>
            <circle cx="46" cy="16" r="14" fill="none" stroke="#ffffff" stroke-width="1.5"/>
            <!-- Spokes -->
            <line x1="46" y1="0" x2="46" y2="32" stroke="#ffffff" stroke-width="1"/>
            <line x1="30" y1="16" x2="62" y2="16" stroke="#ffffff" stroke-width="1"/>
            <line x1="33" y1="5" x2="58" y2="28" stroke="#ffffff" stroke-width="0.7" opacity="0.4"/>
            <line x1="58" y1="5" x2="33" y2="28" stroke="#ffffff" stroke-width="0.7" opacity="0.4"/>
            <!-- Docking port -->
            <rect x="42" y="-4" width="8" height="5" fill="#ffffff"/>
            <rect x="44" y="-6" width="4" height="3" fill="none" stroke="#ffffff" stroke-width="1.5" rx="2"/>
            <!-- Landing legs -->
            <line x1="40" y1="28" x2="37" y2="36" stroke="#ffffff" stroke-width="1.5"/>
            <line x1="52" y1="28" x2="55" y2="36" stroke="#ffffff" stroke-width="1.5"/>
          </g>
          
          <!-- Vignette -->
          <circle cx="300" cy="300" r="275" fill="url(#dcVignette)"/>
          <defs>
            <radialGradient id="dcVignette" cx="50%" cy="50%" r="50%">
              <stop offset="40%" stop-color="#000" stop-opacity="0"/>
              <stop offset="100%" stop-color="#000" stop-opacity="0.45"/>
            </radialGradient>
          </defs>
        </g>
      </svg>
      
      <div class="ds-text">
        <div class="ds-cline">
          <span class="ds-cl">披</span><span class="ds-cr">露</span>
        </div>
        <span class="ds-sep"></span>
        <div class="ds-en">D I S C L O S E R</div>
      </div>
    </section>

      <div class="home-wrap">
        <!-- ===== BREAKING ===== -->
        {latestUAP && (
          <a href={`/vincent-kan-site/blog/${latestUAP.id}/`} class="breaking">
            <span class="breaking-dot"></span>
            <span class="breaking-label">突發</span>
            <span class="breaking-title">{latestUAP.data.title}</span>
            <span class="breaking-arrow">→</span>
          </a>
        )}

        <!-- ===== FEATURED ===== -->
        <div class="featured">
          {latestUAP ? (
            <a href={`/vincent-kan-site/blog/${latestUAP.id}/`} class="featured-main">
              <div class="featured-main-top">
                <span class="featured-tag">🛸 UFO/UAP</span>
                <h2>{latestUAP.data.title}</h2>
                <p>{latestUAP.data.description}</p>
              </div>
              <div class="featured-main-footer">
                <span><FormattedDate date={latestUAP.data.pubDate} /></span>
                <span>閱讀全文 →</span>
              </div>
            </a>
          ) : (
            <div class="featured-main">
              <div class="featured-main-top">
                <span class="featured-tag">🛸 UFO/UAP</span>
                <h2>全球UFO/UAP新聞摘要</h2>
                <p>AI自動搜集每日全球UFO重點新聞，涵蓋政府披露、懸案分析、國際動態。點擊查看最新消息。</p>
              </div>
              <div class="featured-main-footer">
                <span>AI自動更新</span>
              </div>
            </div>
          )}

          <div class="featured-side">
            {uapPosts.slice(1, 3).map(p => (
              <a href={`/vincent-kan-site/blog/${p.id}/`} class="featured-side-item">
                <div class="featured-side-icon">🛸</div>
                <div class="featured-side-body">
                  <h3>{p.data.title}</h3>
                  <p><FormattedDate date={p.data.pubDate} /></p>
                </div>
              </a>
            ))}
            {otherPosts.slice(0, 1).map(p => (
              <a href={`/vincent-kan-site/blog/${p.id}/`} class="featured-side-item">
                <div class="featured-side-icon">📝</div>
                <div class="featured-side-body">
                  <h3>{p.data.title}</h3>
                  <p><FormattedDate date={p.data.pubDate} /></p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- ===== DOMAINS / QUICK LINKS ===== -->
        <div class="domains">
          <a href="/vincent-kan-site/blog" class="domain-item">
            <div class="domain-icon">🛸</div>
            <div class="domain-label">UFO 新聞</div>
            <div class="domain-count">{uapPosts.length} 篇</div>
          </a>
          <a href="/vincent-kan-site/projects" class="domain-item">
            <div class="domain-icon">⚡</div>
            <div class="domain-label">專案</div>
            <div class="domain-count">3 個</div>
          </a>
          <a href="/vincent-kan-site/about" class="domain-item">
            <div class="domain-icon">👤</div>
            <div class="domain-label">關於我</div>
            <div class="domain-count">簡介</div>
          </a>
          <a href="/vincent-kan-site/blog" class="domain-item">
            <div class="domain-icon">📰</div>
            <div class="domain-label">全部文章</div>
            <div class="domain-count">{posts.length} 篇</div>
          </a>
        </div>

        <!-- ===== MORE UFO NEWS ===== -->
        {uapPosts.length > 1 && (
          <>
            <div class="section-hd">
              <div class="section-hd-left">
                <span class="section-hd-acc">/UAP</span>
                <h2>UFO 新聞總覽</h2>
              </div>
              <a href="/vincent-kan-site/blog">查看全部 →</a>
            </div>
            <div class="uap-grid">
              {uapPosts.slice(1, 5).map(p => (
                <a href={`/vincent-kan-site/blog/${p.id}/`} class="uap-card">
                  <div class="uap-card-meta">
                    <span class="uap-tag">🛸 UFO/UAP</span>
                    <span><FormattedDate date={p.data.pubDate} /></span>
                  </div>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </a>
              ))}
            </div>
          </>
        )}

        <!-- ===== OTHER POSTS ===== -->
        {otherPosts.length > 0 && (
          <>
            <div class="section-hd">
              <div class="section-hd-left">
                <span class="section-hd-acc">/BLOG</span>
                <h2>最新文章</h2>
              </div>
              <a href="/vincent-kan-site/blog">全部 →</a>
            </div>
            <div class="feed">
              {otherPosts.slice(0, 4).map(p => (
                <a href={`/vincent-kan-site/blog/${p.id}/`} class="feed-item">
                  <div class="feed-icon">📝</div>
                  <div class="feed-body">
                    <div class="feed-meta"><FormattedDate date={p.data.pubDate} /></div>
                    <h3>{p.data.title}</h3>
                    <p>{p.data.description}</p>
                  </div>
                  <div class="feed-time"><FormattedDate date={p.data.pubDate} /></div>
                </a>
              ))}
            </div>
          </>
        )}

        <!-- ===== FOOTER CTA ===== -->
        <div style="text-align:center;padding:2.5rem 0 3rem;border-top:1px solid var(--border)">
          <p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem">有興趣交流 UFO 話題或者 AI 技術？隨時搵我</p>
          <a href="/vincent-kan-site/about" class="btn btn-primary">關於我</a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>